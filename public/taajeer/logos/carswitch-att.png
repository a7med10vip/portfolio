ربو مزدوج V6 (375 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات جينيسيس G80 المستعملة في السعودية عادةً بين 50,000 و165,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر تيربو رباعي الأسطوانات (304 حصان) أو سعة 3.5 لتر تيربو مزدوج V6 (375 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.8 ثانية (2.5T) إلى حوالي 4.9 ثانية (3.5TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جينيسيس G80 على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من BMW الفئة 5 (45%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Genesis G80 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.6%.\u003c/p\u003e\n\u003cp\u003eنسبة الجنوط التالفة 29.5%. نسبة البقع الداخلية 6.5%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"748:Tb00,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجينيسيس G80 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مستوى جودة قريباً من بي إم دبليو بأسعار أقل بفارق ملحوظ. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر تيربو رباعي الأسطوانات (304 حصان) أو سعة 3.5 لتر تيربو مزدوج V6 (375 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات جينيسيس G80 المستعملة في السعودية عادةً بين 50,000 و165,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر تيربو رباعي الأسطوانات (304 حصان) أو سعة 3.5 لتر تيربو مزدوج V6 (375 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.8 ثانية (2.5T) إلى حوالي 4.9 ثانية (3.5TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جينيسيس G80 على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من BMW الفئة 5 (45%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Genesis G80 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.6%.\u003c/p\u003e\n\u003cp\u003eنسبة الجنوط التالفة 29.5%. نسبة البقع الداخلية 6.5%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"749:T932,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجينيسيس G90 هي سيارة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتنافس مرسيدس-بنز الفئة S مباشرةً بأسعار أقل. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر تيربو مزدوج V6 (375 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (425 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات جينيسيس G90 المستعملة في السعودية عادةً بين 200,000 و250,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر تيربو مزدوج V6 (375 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (425 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع، 3.5TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.0 ثانية (3.5TT) إلى حوالي 4.9 ثانية (5.0L V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c