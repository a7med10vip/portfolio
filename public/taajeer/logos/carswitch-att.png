 سوزوكي Vitara المستعملة في السعودية عادةً بين 19,000 و20,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر BoosterJet تيربو رباعي الأسطوانات (129 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سوزوكي Vitara على نحو 58% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هيونداي كريتا التي تحافظ بنحو 60%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"981:Tbce,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Vogue هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على مختلف التضاريس ومقصورة تنافس سيارات رولز رويس. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو سداسي الأسطوانات خطي P400 (400 حصان) أو سعة 4.4 لتر تيربو مزدوج V8 P530 (530 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات رنج روفر Vogue المستعملة في السعودية عادةً بين 75,000 و90,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو سداسي الأسطوانات خطي P400 (400 حصان) أو سعة 4.4 لتر تيربو مزدوج V8 P530 (530 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع، 3.0L P400)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية (P400) إلى حوالي 4.6 ثانية (V8 P530)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 225-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 52 فحصاً أجرتها كارسويتش لسيارة Range Rover Vogue في السعودية، نسبة أضرار الهيكل الخارجي 10.1%، نسبة ملاحظات المقصورة الداخلية 11.5% (جيدة)، نسبة تلف الجنوط 20.4%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس LX، مرسيدس-بنز GLS، وبي إم دبليو X7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"982:Tbce,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Vogue هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على مختلف التضاريس ومقصورة تنافس سيارات رولز رويس. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو سداسي الأسطوانات خطي P400 (400 حصان) أو سعة 4.4 لتر تيربو مزدوج V8 P530 (530 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات رنج روفر Vogue المستعملة في السعودية عادةً بين 75,000 و90,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو سداسي الأسطوانات خطي P400 (400 حصان) أو سعة 4.4 لتر تيربو مزدوج V8 P530 (530 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع، 3.0L P400)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية (P400) إلى حوالي 4.6 ثانية (V8 P530)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 225-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإص