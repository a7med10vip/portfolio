روبية المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (237 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (360 حصان، CT5-V)، مع ناقل حركة أوتوماتيكي من 10 سرعات. تتراوح أسعار سيارات كاديلاك CT5 المستعملة بعمر خمس إلى ست سنوات في السعودية بين 95,000 و440,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (237 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (360 حصان، CT5-V)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.7 ثانية (2.0T) إلى حوالي 5.1 ثانية (3.0TT V)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كاديلاك CT5 على حوالي 44% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من جينيسيس G70 (41%) وأقل من BMW الفئة 3 (45%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وجينيسيس G70 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6be:Ta71,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكاديلاك CT5 هي سيدان متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مقصورة مجهزة جيداً ومحرك 2.0 لتر تيربو بأسعار أقل من السيارات الأوروبية المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (237 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (360 حصان، CT5-V)، مع ناقل حركة أوتوماتيكي من 10 سرعات. تتراوح أسعار سيارات كاديلاك CT5 المستعملة بعمر خمس إلى ست سنوات في السعودية بين 95,000 و440,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (237 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (360 حصان، CT5-V)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.7 ثانية (2.0T) إلى حوالي 5.1 ثانية (3.0TT V)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كاديلاك CT5 على حوالي 44% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من جينيسيس G70 (41%) وأقل من BMW الفئة 3 (45%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وجينيسيس G70 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6bf:T9fc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكاديلاك CT6 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتوفر مساحة مقصورة تقارب بي إم دبليو الفئة 7 بأسعار أقل بكثير من السيارات الألمانية المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6، مع ناقل حركة من 8 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات كاديلاك CT6 المستعملة في السعودية عادةً بين 75,000 و95,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.6L V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كاديلاك CT6 على حوالي 44% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من BMW الفئة 7 (45%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، مرسيدس-بنز الفئة S، وجينيسيس G90 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c0:T9fc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكاديلاك CT6 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتوفر مساحة مقصورة تقارب بي إم دبليو الفئة 7 بأسعار أقل بكثير من السيارات الألمانية المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6، مع ناقل حركة من 8 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات كاديلاك CT6 المستعملة في السعودية عادةً بين 75,000 و95,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.6L V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وس