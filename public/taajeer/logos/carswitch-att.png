rra في السعودية، نسبة أضرار الهيكل الخارجي 6.7%، نسبة ملاحظات المقصورة الداخلية 5.6% (ممتازة)، نسبة تلف الجنوط 8.3%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى إم جي Hs، جيلي كولراي، وشانجان CS35 Plus عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"641:Ta7a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eسوزوكي Baleno هي هاتشباك صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.2 لتر DualJet سحب طبيعي رباعي الأسطوانات (90 حصان)، مع ناقل حركة أوتوماتيكي متغير باستمرار (CVT) أو من 5 سرعات يدوي. تتراوح أسعار سيارات سوزوكي Baleno المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 40,000 و55,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.2 لتر DualJet سحب طبيعي رباعي الأسطوانات (90 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أوتوماتيكي أو من 5 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 170 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سوزوكي Baleno على نحو 60% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 26 فحصاً أجرتها كارسويتش لسيارة Suzuki Baleno في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 13.0% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"642:Ta7a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eسوزوكي Baleno هي هاتشباك صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.2 لتر DualJet سحب طبيعي رباعي الأسطوانات (90 حصان)، مع ناقل حركة أوتوماتيكي متغير باستمرار (CVT) أو من 5 سرعات يدوي. تتراوح أسعار سيارات سوزوكي Baleno المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 40,000 و55,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.2 لتر DualJet سحب طبيعي رباعي الأسطوانات (90 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أوتوماتيكي أو من 5 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 170 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سوزوكي Baleno على نحو 60% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 26 فحصاً أجرتها كارسويتش لسيارة Suzuki Baleno في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 13.0% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"643:T87b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبايك BJ40 هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (197 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات بايك BJ40 المستعملة في السعودية عادةً بين 60,000 و75,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (197 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بايك BJ40 على حوالي 54% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من جيب رانغلر (56%)، وهو أعلى من متوسط علامة بايك (53%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى جيب رانجلر، فورد برونكو، وتويوتا إف جي كروزر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"644:T87b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبايك BJ40 هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (197 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات بايك BJ40 المستعملة في السعودية عادةً بين 60,000 و75,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (197 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eن