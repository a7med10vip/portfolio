i\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع، 3.0L P400)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قدرات جيدة على الطرق الوعرة وثباتاً مناسباً في ظروف القيادة المختلفة. توفر مقصورة مريحة وجودة داخلية جيدة بالنسبة إلى فئتها السعرية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح مرتفعة في بعض الطرازات، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سيارات رينج روفر على حوالي 46% من قيمتها الأصلية بعد مرور 5 سنوات. وهي أكثر تراجعاً من لاند روفر حوالي 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 306 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.1% — أقل من بورشه (13.6%). لا أعطال تكييف مسجلة. للمشترين الذين يقارنون بين رينج روفر وGerman، تدعم بيانات فحص كارسويتش هذا الخيار باستمرار. نسبة البقع الداخلية 8.6% — منخفضة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى بورشه، مرسيدس-بنز، لكزس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"586:Ta93,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرينج روفر علامة مرموقة للسيارات الرياضية متعددة الاستخدامات وتحظى بطلب قوي في السعودية عبر مختلف فئاتها. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو P200/P300 رباعي الأسطوانات أو سعة 3.0 لتر تيربو P400 سداسي الأسطوانات خطي، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات رينج روفر المستعملة في السعودية عادةً بين 110,000 و185,000 ريال، بحسب سنة الصنع والممشى والحالة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e