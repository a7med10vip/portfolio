 الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر B3 تيربو هجين خفيف ثلاثي الأسطوانات (163 حصان) أو سعة 2.0 لتر B4 هجين خفيف (197 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Geartronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، B3)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (B3)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 190-200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فولفو XC40 على نحو 37% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X1 التي تحافظ بنحو 30%، لكنها أقل من لاند روفر Discovery Sport التي تحافظ بنحو 44%، كما تقل عن متوسط العلامة البالغ 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X1، أودي Q3، ومرسيدس-بنز GLA عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"9b0:Ta6d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفولفو XC40 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مدخلاً مناسب السعر إلى سيارات فولفو الفاخرة بسعر أقل من XC60. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر B3 تيربو هجين خفيف ثلاثي الأسطوانات (163 حصان) أو سعة 2.0 لتر B4 هجين خفيف (197 حصان)، مع ناقل حركة من 8 سرعات Geartronic أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر B3 تيربو هجين خفيف ثلاثي الأسطوانات (163 حصان) أو سعة 2.0 لتر B4 هجين خفيف (197 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Geartronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، B3)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (B3)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 190-200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فولفو XC40 على نحو 37% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X1 التي تحافظ بنحو 30%، لكنها أقل من لاند روفر Discovery Sport التي تحافظ بنحو 44%، كما تقل عن متوسط العلامة البالغ 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X1، أودي Q3، ومرسيدس-بنز GLA عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"9b1:T99d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفولفو XC60 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بالتقدير بفضل تصميمها الاسكندنافي، وسمعتها في السلامة، وكفاءة نظام الهايبرد الخفيف. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر B5 تيربو وهجين خفيف رباعي الأسطوانات (250 حصان) أو B6 هجين خفيف (300 حصان)، مع ناقل حركة من 8 سرعات Geartronic أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر B5 تيربو وهجين خفيف رباعي الأسطوانات (250 حصان) أو B6 هجين خفيف (300 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Geartronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، B5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.1 ثانية (B5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فولفو XC60 على حوالي 48% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من بي إم دبليو X3 (38%) وأقل من أودي Q5 (49%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، أودي Q5، ومرسيدس-بنز GLC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"9b2:T99d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفولفو XC60 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بالتقدير بفضل تصميمها الاسكندنافي، وسمعتها في السلامة، وكفاءة نظام الهايبرد الخفيف. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر B5 تيربو وهجين خفيف رباعي الأسطوانات (250 حصان) أو B6 هجين خفيف (300 حصان)، مع ناقل حركة من 8 سرعات Geartronic أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر B5 تيربو وهجين خفيف رباعي الأسطوانات (250 حصان) أو B6 هجين خفيف (300 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Geartronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، B5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.1 ثانية (B5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف ال