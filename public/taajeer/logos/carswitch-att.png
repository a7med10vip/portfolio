رعات أو من 6 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا 86 المستعملة في السعودية عادةً بين 18,000 و205,000 ريال، بحسب الطراز وسنة الصنع.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.4 لتر بسحب طبيعي flat-أربعة (228 حصان، GR86)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو من 6 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.3 ثانية (أوتوماتيكي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 226 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا 86 على نحو 55% من قيمتها الأصلية بعد 5 سنوات، كما تقل عن متوسط العلامة البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى سوبارو Brz، مازدا MX-5، وبي إم دبليو Z4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e5f4:T"])</script><script>self.__next_f.push([1,"7f2,\u003cp\u003eتويوتا 86 هي كوبيه عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.4 لتر بسحب طبيعي flat-أربعة (228 حصان، GR86)، مع ناقل حركة يدوي من 6 سرعات أو من 6 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا 86 المستعملة في السعودية عادة