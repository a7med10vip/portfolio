ترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"889:T927,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي Q60 هي كوبيه فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً قوياً من محرك V6 ثنائي التيربو بأسعار أقل من سيارات بي إم دبليو الفئة 4 المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.0 ثانية (3.0T 400 حصان Red Sport)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي Q60 على نحو 46% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو الفئة 4 التي تحافظ بنحو 45%، لكنها أقل من أودي A5 التي تحافظ بنحو 49%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 4، أودي A5، ولكزس RC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"88a:T927,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي Q60 هي كوبيه فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً قوياً من محرك V6 ثنائي التيربو بأسعار أقل من سيارات بي إم دبليو الفئة 4 المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.0 ثانية (3.0T 400 حصان Red Sport)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي Q60 على نحو 46% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو الفئة 4 التي تحافظ بنحو 45%، لكنها أقل من أودي A5 التي تحافظ بنحو 49%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 4، أودي A5، ولكزس RC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"88b:T96e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q7 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بطلب مرتفع كسيارة دفع رباعي فاخرة كبيرة الحجم بثلاثة صفوف من المقاعد. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TFSI تيربو V6 (333-380 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)، مع ناقل حركة من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي Q7 المستعملة في السعودية عادةً بين 35,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TFSI تيربو V6 (333-380 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.3 ثانية لفئة 3.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 245 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 73 فحصاً لسيارة Q7 في السعودية. نسبة أضرار الهيكل الخارجي 17.5% ونسبة البقع الداخلية 16.7%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، ولكزس RX عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"88c:T96e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q7 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بطلب مرتفع كسيارة دفع رباعي فاخرة كبيرة الحجم بثلاثة صفوف من المقاعد. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TFSI تيربو V6 (333-380 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)، مع ناقل حركة من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي Q7 المستعملة في السعودية عادةً بين 35,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TFSI تيربو V6 (333-380 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.3 ثانية لفئة 3.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 245 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eال