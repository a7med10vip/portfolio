cript>self.__next_f.push([1,"65b:T7a5,\u003cp\u003eكيا Cadenza هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم طابعاً فاخراً ضمن سيدان كبيرة الحجم بأسعار سيارات مستعملة تنافسية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.3 لتر بسحب طبيعي V6 (290 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات كيا Cadenza المستعملة في السعودية عادةً بين 35,000 و50,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.3 لتر بسحب طبيعي V6 (290 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا Cadenza على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط كيا البالغ 51%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e65c:T7a5,\u003cp\u003eكيا Cadenza هي سيدان كبيرة الحجم فاخرة متو"])</script><script>self.__next_f.push([1,"فرة في سوق السيارات المستعملة في السعودية. وتقدم طابعاً فاخراً ضمن سيدان كبيرة الحجم بأسعار سيارات مستعملة تنافسية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.3 لتر بسحب طبيعي V6 (290 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات كيا Cadenza المستعملة في السعودية عادةً بين 35,000 و50,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.3 لتر بسحب طبيعي V6 (290 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا Cadenza على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط كيا البالغ 51%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e65d:T943,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيفروليه كامارو هي كوبيه متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر V6 (335 حصان) أو سعة 6.2 لتر V8 (455 حصان SS / 650 حصان ZL1)، مع ناقل حركة يدوي من 6 سرعات أو من 8 سرعات أوتوماتيكي. تتراوح أسعار سيارات شيفروليه كامارو المستعملة في السعودية عادةً بين 145,000 و230,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر V6 (335 حصان) أو سعة 6.2 لتر V8 (455 حصان SS / 650 حصان ZL1)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو من 8 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V8 SS)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.4 ثانية (V8 SS) إلى حوالي 3.5 ثانية (ZL1 Supercharged)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-290 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شيفروليه كامارو على نحو 45% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد موستانج التي تحافظ بنحو 37%، كما تتفوق على متوسط العلامة البالغ 37%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد موستانج، دودج تشالنجر، ونيسان Z عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"65e:T943,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيفروليه كامارو هي كوبيه متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر V6 (335 حصان) أو سعة 6.2 لتر V8 (455 حصان SS / 650 حصان ZL1)، مع ناقل حركة يدوي من 6 سرعات أو من 8 سرعات أوتوماتيكي. تتراوح أسعار سيارات شيفروليه كامارو المستعملة في السعودية عادةً بين 145,000 و230,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر V6 (335 حصان) أو سعة 6.2 لتر V8 (455 حصان SS / 650 حصان ZL1)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو من 8 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V8 SS)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.4 ثانية (V8 SS) إلى حوالي 3.5 ثانية (ZL1 Supercharged)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-290 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شيفروليه كامارو على نحو 45% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد موستانج التي تحافظ بنحو 37%، كما تتفوق على متوسط العلامة البالغ 37%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد موستانج، دودج تشالنجر، ونيسان Z عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"65f:Tbc1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا كامري هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 3.5 لتر بسحب طبيعي V6 (301 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات تويوتا كامري المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 95,000 و130,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 55,000 و100,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 3.5 لتر بسحب طبيعي V6 (301 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L) إلى حوالي 6.5 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا كامري على نحو 53% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا Optima التي تحافظ بنحو 28%، كما تقل عن متوسط العلامة البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 263 فحصاً لسيارة كامري في السعودية، نسبة أضرار الهيكل الخارجي 24.7% ونسبة البقع الداخلية 15.1%. نسبة أعطال التكييف 1.1% (منخفضة). مقارنةً بهيونداي سوناتا (42.2% هيكل — أسوأ بفارق واضح) في نفس الفئة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هوندا، نيسان، هيونداي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"660:Tbc1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا كامري هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 3.5 لتر بسحب طبيعي V6 (301 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات تويوتا كامري المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 95,000 و130,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 55,000 و100,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 3.5 لتر بسحب طبيعي V6 (301 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L) إلى حوالي 6.5 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا كامري على نحو 53% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا Optima التي تحافظ بنحو 28%، كما تقل عن متوسط العلامة البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 263 فحصاً لسيارة كامري في السعودية، نسبة أضرار الهيكل الخارجي 24.7% ونسبة البقع الداخلية 15.1%. نسبة أعطال التكييف 1.1% (منخفضة). مقارنةً بهيونداي سوناتا (42.2% هيكل — أسوأ بفارق واضح) في نفس الفئة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هوندا، نيسان، هيونداي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"661:Tb39,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيفروليه Captiva هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.4 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.0 لتر بسحب طبيعي V6، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات شيفروليه Captiva المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 65,000 و70,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و80,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.4 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.0 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (2.4L) إلى حوالي 8.5 ثانية (3.0L V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شيفروليه Captiva على نحو 39% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على دودج التي تحافظ بنحو 38%، لكنها أقل من فورد التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 178 فحصاً لسيارة كابتيفا في السعودية، نسبة أضرار الهيكل الخارجي 11.3% ونسبة البقع الداخلية 7.4% — مقارنةً بـ تضعها متقدمةً على هيونداي Tucson (13.6% هيكل، 13.9% داخل) و نيسان إكس-تريل (13.5% هيكل، 12.7% داخل). لا أعطال تكييف مسجلة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، ونيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"662:Tb39,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيفروليه Captiva هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.4 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.0 لتر بسحب طبيعي V6، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات شيفروليه Ca