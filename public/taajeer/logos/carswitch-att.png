 أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A220 على حوالي 52% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من MINI كوبر (48%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5fc:T9c1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A220 هي هاتشباك مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم محرك 2.0T ضمن هاتشباك مدمجة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (190 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A220 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (190 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.2 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A220 على حوالي 52% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من MINI كوبر (48%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5fd:T902,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A250 هي سيارة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (224 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A250 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (224 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.2 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A250 على نحو 72% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على ميني كوبر التي تحافظ بنحو 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5fe:T902,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A250 هي سيارة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (224 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A250 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (224 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.2 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A250 على نحو 72% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على ميني كوبر التي تحافظ بنحو 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5ff:Ta2c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A3 هي سيدان مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بجودة تصنيع متينة، ومقصورة راقية، ومحركات تيربو فعّالة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A3 المستعملة في السعودية عادةً بين 40,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.9 ثانية لفئة 1.4T إلى حوالي 6.5 ثانية لفئة 2.0T\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-240 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A3 على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز CLA250 (34%) وأقل من مرسيدس-بنز C300 (50%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وفولكس واجن جولف GTI عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"600:Ta2c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A3 هي سيدان مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بجودة تصنيع متينة، ومقصورة راقية، ومحركات تيربو فعّالة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A3 المستعملة في السعودية عادةً بين 40,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.9 ثانية لفئة 1.4T إلى حوالي 6.5 ثانية لفئة 2.0T\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-240 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A3 على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز CLA250 (34%) وأقل من مرسيدس-بنز C300 (50%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وفولكس واجن جولف GTI عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"601:T79a,\u003cp\u003eمرسيدس-بنز A35 AMG هي سيدان مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (306 حصان)، مع ناقل حركة من 8 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A35 AMG المستعملة في السعودية عادةً بين 140,000 و170,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (306 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e602:T79a,\u003cp\u003eمرسيدس-بنز A35 AMG هي سيدان مدمجة عالية الأداء م"])</script><script>self.__next_f.push([1,"توفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (306 حصان)، مع ناقل حركة من 8 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A35 AMG المستعملة في السعودية عادةً بين 140,000 و170,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (306 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e603:T9bd,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A4 هي سيدان متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بتقدير كبير بفضل جودة تصنيعها، وراحة قيادتها، ومقصورتها الفاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (150-252 حصان بحسب في tune) أو سعة 3.0 لتر TFSI V6، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي A4 المستعملة في السعودية عادةً بين 25,000 و35,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (150-252 حصان بحسب في tune) أو سعة 3.0 لتر TFSI V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 2.0T 190 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 5.7 ثانية (2.0T 252 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، ولكزس IS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"604:T9bd,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A4 هي سيدان متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بتقدير كبير بفضل جودة تصنيعها، وراحة قيادتها، ومقصورتها الفاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (150-252 حصان بحسب في tune) أو سعة 3.0 لتر TFSI V6، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي A4 المستعملة في السعودية عادةً بين 25,000 و35,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (150-252 حصان بحسب في tune) أو سعة 3.0 لتر TFSI V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 2.0T 190 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 5.7 ثانية (2.0T 252 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، ولكزس IS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"605:T9b8,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A45 AMG هي هاتشباك مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (421 حصان، A45 S AMG)، مع ناقل حركة من 8 سرعات AMG Speedshift DCT. تتراوح أسعار سيارات مرسيدس-بنز A45 AMG المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (421 حصان، A45 S AMG)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات AMG Speedshift DCT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.9 ثانية (A45 S 4MATIC+)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يولد المحرك قوة تبلغ 421 حصان، ويقدم أحد أعلى معدلات القوة النوعية في فئته. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A45 AMG على حوالي 51% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من MINI كوبر (48%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"606:T9b8,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A45 AMG هي هاتشباك مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (421 حصان، A45 S AMG)، مع ناقل حركة من 8 سرعات AMG Speedshift DCT. تتراوح أسعار سيارات مرسيدس-بنز A45 AMG المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر AMG تيربو رباعي الأسطوانات (421 حصان، A45 S AMG)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات AMG Speedshift DCT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.9 ثانية (A45 S 4MATIC+)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يولد المحرك قوة تبلغ 421 حصان، ويقدم أحد أعلى معدلات القوة النوعية في فئته. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز A45 AMG على حوالي 51% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من MINI كوبر (48%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"607:T8a7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A5 هي كوبيه متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI V6 (S5)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A5 المستعملة في السعودية عادةً بين 125,000 و150,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI V6 (S5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 4.7 ثانية (S5 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 4، مرسيدس-بنز CLE، ولكزس RC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Audi A5 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"608:T8a7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A5 هي كوبيه متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI V6 (S5)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A5 المستعملة في السعودية عادةً بين 125,000 و150,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI V6 (S5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 4.7 ثانية (S5 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 4، مرسيدس-بنز CLE، ولكزس RC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Audi A5 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"609:Tbfd,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A6 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بمقصورة راقية، وقيادة متزنة، وتقنيات فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI تيربو V6 (335 حصان)، مع ناقل حركة من 7 سرعات S tronic أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي A6 المستعملة في السعودية عادةً بين 45,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI تيربو V6 (335 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية لفئة 2.0T إلى حوالي 5.5 ثانية (3.0T 335 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 238-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A6 على نحو 31% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو 520 التي تحافظ بنحو 32%، لكنها أقل من لكزس ES250 التي تحافظ بنحو 49%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 49 فحصاً أجرتها كارسويتش لسيارة Audi A6 في السعودية، نسبة أضرار الهيكل الخارجي 22.1% (متوسطة)، نسبة البقع الداخلية 6.1%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 5، مرسيدس-بنز الفئة E، ولكزس ES عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60a:Tbfd,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A6 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بمقصورة راقية، وقيادة متزنة، وتقنيات فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI تيربو V6 (335 حصان)، مع ناقل حركة من 7 سرعات S tronic أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي A6 المستعملة في السعودية عادةً بين 45,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات أو سعة 3.0 لتر TFSI تيربو V6 (335 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية لفئة 2.0T إلى حوالي 5.5 ثانية (3.0T 335 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 238-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A6 على نحو 31% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو 520 التي تحافظ بنحو 32%، لكنها أقل من لكزس ES250 التي تحافظ بنحو 49%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 49 فحصاً أجرتها كارسويتش لسيارة Audi A6 في السعودية، نسبة أضرار الهيكل الخارجي 22.1% (متوسطة)، نسبة البقع الداخلية 6.1%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 5، مرسيدس-بنز الفئة E، ولكزس ES عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60b:T9ad,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A7 هي كوبيه فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين الراحة في الرحلات الطويلة والتصميم المميز لهيكل فاستباك بأربعة أبواب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TFSI تيربو V6 (335 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A7 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 200,000 و350,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 85,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TFSI تيربو V6 (335 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية لفئة 3.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A7 على حوالي 41% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز S500 (36%) وأقل من بي إم دبليو 750 (53%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 6، مرسيدس-بنز CLS، وبورش Panamera عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60c:T9ad,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A7 هي كوبيه فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين الراحة في الرحلات الطويلة والتصميم المميز لهيكل فاستباك بأربعة أبواب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TFSI تيربو V6 (335 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي A7 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 200,000 و350,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 85,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TFSI تيربو V6 (335 حصان) أو 55 TFSI هجين خفيف V6 (340 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية لفئة 3.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A7 على حوالي 41% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز S500 (36%) وأقل من بي إم دبليو 750 (53%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 6، مرسيدس-بنز CLS، وبورش Panamera عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60d:Tb5f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي A8 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتلائم المشترين الباحثين عن حضور ليموزين ألمانية رائدة بسعر أقل من S-Class. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TFSI V6 (340 حصان) أو سعة 4.0 لتر TFSI تيربو مزدوج V8 (460 حصان)، مع ناقل حركة من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي A8 المستعملة في السعودية عادةً بين 55,000 و80,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TFSI V6 (340 حصان) أو سعة 4.0 لتر TFSI تيربو مزدوج V8 (460 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.7 ثانية لفئة 3.0T إلى حوالي 4.4 ثانية لفئة 4.0T V8\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي A8 على نحو 30% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على مرسيدس-بنز S400 التي تحافظ بنحو 34%، لكنها أقل من بي إم دبليو 735 التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 65 فحصاً أجرتها كارسويتش لسيارة Audi A8 في السعودية، نسبة أضرار الهيكل الخارجي 35.3%، نسبة البقع الداخلية 23.4% (متوسطة)، نسبة تلف الجنوط 22.6%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، مرسيدس-بنز الفئة S، ولكزس LS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60e:Tb5f,"