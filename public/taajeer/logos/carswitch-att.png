MG GT، بي إم دبليو M4، وشيفروليه كورفيت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5f9:T91a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A200 هي سيدان فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مدخلاً إلى فئة السيارات الفاخرة مع محرك تيربو ونظام MBUX للمعلومات والترفيه. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات (163 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A200 المستعملة في السعودية عادةً بين 130,000 و135,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو رباعي الأسطوانات (163 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 31 فحصاً لسيارة مرسيدس-بنز A200 في السعودية. نسبة البقع الداخلية 6.5% (جيدة). أضرار الجنوط عند 0.0% — مماثل لـ very rarely (0.0%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eبها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 7.6%. ينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، أودي A3، وميني كوبر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5fa:T91a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز A200 هي سيدان فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مدخلاً إلى فئة السيارات الفاخرة مع محرك تيربو ونظام MBUX للمعلومات والترفيه. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات (163 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز A200 المستعملة في السعودية عادةً بين 130,000 و135,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو رباعي الأسطوانات (163 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 31 فحصاً لسيارة مرسيدس-بنز A200 في السعودية. نسبة البق