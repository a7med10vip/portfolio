ودية عادةً بين 30,000 و90,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر SkyActiv-G تيربو رباعي الأسطوانات (227-256 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.3 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-9 على حوالي 51% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من Ford إكسبلورر (49%) وأقل من تويوتا Highlander (58%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلاندر، كيا تيلورايد، وفورد إكسبلورر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6cc:T8f3,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-9 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم جودة مقصورة قريبة من الفخامة بأسعار الفئة السائدة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر SkyActiv-G تيربو رباعي الأسطوانات (227-256 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرع