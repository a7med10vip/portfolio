03e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى جينيسيس G70، لكزس ES، وبي إم دبليو الفئة 5 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"867:Ta79,"])</script><script>self.__next_f.push([1,"\u003cp\u003eميتسوبيشي Outlander هي كروس أوفر متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.4 لتر MIVEC سحب طبيعي رباعي الأسطوانات (167 حصان) أو سعة 3.0 لتر بسحب طبيعي V6 (224 حصان)، مع ناقل حركة CVT أو من 6 سرعات أوتوماتيكي. تتراوح أسعار سيارات ميتسوبيشي Outlander المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 120,000 و125,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.4 لتر MIVEC سحب طبيعي رباعي الأسطوانات (167 حصان) أو سعة 3.0 لتر بسحب طبيعي V6 (224 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (2.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ ميتسوبيشي Outlander على حوالي 36% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط ميتسوبيشي البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Mitsubishi Outlander التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 18.9%. نسبة أعطال التكييف 6.7%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى نيسان، تويوتا، هوندا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"868:Ta79,"])</script><script>self.__next_f.push([1,"\u003cp\u003eميتسوبيشي Outlander هي كروس أوفر متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.4 لتر MIVEC سحب طبيعي رباعي الأسطوانات (167 حصان) أو سعة 3.0 لتر بسحب طبيعي V6 (224 حصان)، مع ناقل حركة CVT أو من 6 سرعات أوتوماتيكي. تتراوح أسعار سيارات ميتسوبيشي Outlander المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 120,000 و125,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.4 لتر MIVEC سحب طبيعي رباعي الأسطوانات (167 حصان) أو سعة 3.0 لتر بسحب طبيعي V6 (224 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (2.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ ميتسوبيشي Outlander على حوالي 36% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط ميتسوبيشي البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Mitsubishi Outlander التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 18.9%. نسبة أعطال التكييف 6.7%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى نيسان، تويوتا، هوندا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"869:Ta20,"])</script><script>self.__next_f.push([1,"\u003cp\u003eميتسوبيشي باجيرو هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (202 حصان) أو سعة 3.8 لتر بسحب طبيعي V6 (248 حصان)، مع ناقل حركة أوتوماتيكي من 5 سرعات. تتراوح أسعار سيارات ميتسوبيشي باجيرو المستعملة في السعودية عادةً بين 35,000 و55,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (202 حصان) أو سعة 3.8 لتر بسحب طبيعي V6 (248 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، 3.8L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (3.8L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 169 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.2% — أقل من تويوتا (1.1%). نسبة البقع الداخلية 15.4%. لا أعطال تكييف مسجلة. أفضل من نيسان (8.2%). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، تويوتا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86a:Ta20,"])</script><script>self.__next_f.push([1,"\u003cp\u003eميتسوبيشي باجيرو هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (202 حصان) أو سعة 3.8 لتر بسحب طبيعي V6 (248 حصان)، مع ناقل حركة أوتوماتيكي من 5 سرعات. تتراوح أسعار سيارات ميتسوبيشي باجيرو المستعملة في السعودية عادةً بين 35,000 و55,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (202 حصان) أو سعة 3.8 لتر بسحب طبيعي V6 (248 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، 3.8L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (3.8L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 169 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.2% — أقل من تويوتا (1.1%). نسبة البقع الداخلية 15.4%. لا أعطال تكييف مسجلة. أفضل من نيسان (8.2%). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، تويوتا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86b:Ta39,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي باليسيد هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.8 لتر بسحب طبيعي V6 (291 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات هيونداي باليسيد المستعملة في السعودية عادةً بين 105,000 و165,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.8 لتر بسحب طبيعي V6 (291 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي Palisade على حوالي 57% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هيونداي Elantra (63%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 47 فحصاً لسيارة هيونداي Palisade في السعودية. نسبة البقع الداخلية 4.3% (جيدة). أضرار الجنوط عند 0.0% — مماثل لـ very rarely (0.0%).معدل المالك الأول 32%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 5.3%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى كيا، تويوتا، وفورد عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86c:Ta39,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي باليسيد هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.8 لتر بسحب طبيعي V6 (291 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات هيونداي باليسيد المستعملة في السعودية عادةً بين 105,000 و165,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.8 لتر بسحب طبيعي V6 (291 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي Palisade على حوالي 57% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هيونداي Elantra (63%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 47 فحصاً لسيارة هيونداي Palisade في السعودية. نسبة البقع الداخلية 4.3% (جيدة). أضرار الجنوط عند 0.0% — مماثل لـ very rarely (0.0%).معدل المالك الأول 32%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 5.3%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى كيا، تويوتا، وفورد عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86d:T8bb,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبورشه باناميرا هي سيدان فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً قوياً من محركات V6 أو V8 ثنائية التيربو ضمن هيكل بأربعة أبواب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (330-480 حصان بحسب في trim) أو سعة 4.0 لتر تيربو مزدوج V8 (550-700 حصان Turbo S)، مع ناقل حركة من 8 سرعات PDK مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات بورشه باناميرا المستعملة في السعودية عادةً بين 40,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (330-480 حصان بحسب في trim) أو سعة 4.0 لتر تيربو مزدوج V8 (550-700 حصان Turbo S)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات PDK مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، 3.0TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.4 ثانية (3.0TT) إلى حوالي 3.4 ثانية (Turbo S E-هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270-310 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى مرسيدس-بنز CLS، بي إم دبليو الفئة 8، وأودي A7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86e:T8bb,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبورشه باناميرا هي سيدان فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً قوياً من محركات V6 أو V8 ثنائية التيربو ضمن هيكل بأربعة أبواب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (330-480 حصان بحسب في trim) أو سعة 4.0 لتر تيربو مزدوج V8 (550-700 حصان Turbo S)، مع ناقل حركة من 8 سرعات PDK مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات بورشه باناميرا المستعملة في السعودية عادةً بين 40,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (330-480 حصان بحسب في trim) أو سعة 4.0 لتر تيربو مزدوج V8 (550-700 حصان Turbo S)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات PDK مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، 3.0TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.4 ثانية (3.0TT) إلى حوالي 3.4 ثانية (Turbo S E-هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270-310 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى مرسيدس-بنز CLS، بي إم دبليو الفئة 8، وأودي A7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"86f:Ta90,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفولكس واجن باسات هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.8 لتر TSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TSI تيربو رباعي الأسطوانات (220 حصان)، مع ناقل حركة من 7 سرعات DSG مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات فولكس واجن باسات المستعملة في السعودية عادةً بين 35,000 و45,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.8 لتر TSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TSI تيربو رباعي الأسطوانات (220 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DSG مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فولكس واجن Passat على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من تويوتا Camry (53%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Volkswagen Passat التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 29.7%. نسبة البقع الداخلية 23.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"870:Ta90,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفولكس واجن باسات هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.8 لتر TSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TSI تيربو رباعي الأسطوانات (220 حصان)، مع ناقل حركة من 7 سرعات DSG مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات فولكس واجن باسات المستعملة في السعودية عادةً بين 35,000 و45,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.8 لتر TSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TSI تيربو رباعي الأسطوانات (220 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DSG مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فولكس واجن Passat على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من تويوتا Camry (53%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Volkswagen Passat التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 29.7%. نسبة البقع الداخلية 23.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"871:Tab6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باثفايندر هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (284 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات نيسان باثفايندر المستعملة في السعودية عادةً بين 25,000 و40,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (284 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان باثفايندر على نحو 31% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من كيا كارنفال التي تحافظ بنحو 39%، كما تقل عن متوسط العلامة البالغ 55%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eمن بين 99 فحصاً لسيارة باثفايندر في السعودية:\u003c/strong\u003e نقطة الحذر: نسبة أعطال التكييف 8.2%.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 22.5% (متوسطة). مقارنةً بـToyota فورتونر (14.8% هيكل، 1.1% داخل/تكييف). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، تويوتا، ميتسوبيشي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"872:Tab6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باثفايندر هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (284 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات نيسان باثفايندر 