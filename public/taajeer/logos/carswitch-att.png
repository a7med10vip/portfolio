u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (197 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شانجان Uni-T على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من Changan CS35 Plus (48%) وأقل من Geely كولري (56%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 20 فحصاً لسيارة شانجان Uni-T في السعودية. just 1.7% (very rarely (1.7%)) نسبة البقع الداخلية 0.0%. أضرار الجنوط عند 10.0%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى إم جي، جيلي، شانجان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.p