\u003e سعة 3.6 لتر بنتاستار V6 (293 حصان) أو سعة 5.7 لتر HEMI V8 (360 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات TorqueFlite أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Durango على نحو 44% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 154 فحصاً أجرتها كارسويتش لسيارة Dodge Durango في السعودية، نسبة أضرار الهيكل الخارجي 27.5% (جيدة)، نسبة ملاحظات المقصورة الداخلية 18.3%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد إكسبلورر، جيب جراند شيروكي، وتويوتا هايلاندر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6da:Ta72,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدودج Durango هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر بنتاستار V6 (293 حصان) أو سعة 5.7 لتر HEMI V8 (360 حصان)، مع ناقل حركة من 8 سرعات TorqueFlite أوتوماتيكي. تتراوح أسعار سيارات دودج Durango المستعملة في السعودية عادةً بين 30,000 و90,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر بنتاستار V6 (293 حصان) أو سعة 5.7 لتر HEMI V8 (360 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات TorqueFlite أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Durango على نحو 44% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 154 فحصاً أجرتها كارسويتش لسيارة Dodge Durango في السعودية، نسبة أضرار الهيكل الخارجي 27.5% (جيدة)، نسبة ملاحظات المقصورة الداخلية 18.3%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد إكسبلورر، جيب جراند شيروكي، وتويوتا هايلاندر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6db:Tb35,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرينو Duster هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (114 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (143 حصان)، مع ناقل حركة CVT أو من 6 سرعات يدوي. تتراوح أسعار سيارات رينو Duster المستعملة في السعودية عادةً بين 13,000 و25,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (114 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (143 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.0 ثانية (1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165-175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ رينو Duster على نحو 45% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بيجو التي تحافظ بنحو 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 64 فحصاً أجرتها كارسويتش لسيارة Renault Duster في السعودية، نسبة أضرار الهيكل الخارجي 27.2% (متوسطة)، نسبة ملاحظات المقصورة الداخلية 9.4% (منضبطة)، نسبة أعطال التكييف 3.2% (أعلى من متوسط الفئة — يستحق الفحص الدقيق.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بيجو، نيسان، وهيونداي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6dc:Tb35,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرينو Duster هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (114 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (143 حصان)، مع ناقل حركة CVT أو من 6 سرعات يدوي. تتراوح أسعار سيارات رينو Duster المستعملة في السعودية عادةً بين 13,000 و25,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (114 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (143 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.0 ثانية (1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165-175 كم/س\