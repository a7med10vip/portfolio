l\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز V250 على نحو 55% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا جرانفيا التي تحافظ بنحو 46%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا جرانفيا، هيونداي ستاريا، وكيا كارنفال عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"972:T92f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز V250 هي سيارة عائلية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم مقصورة مرسيدس كاملة ومحرك 2.0T تيربو قوي. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان)، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز V250 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cl