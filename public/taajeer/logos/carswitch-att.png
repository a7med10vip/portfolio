6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي توسان هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (155 حصان) أو سعة 1.6 لتر تيربو رباعي الأسطوانات (177 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو من 7 سرعات DCT. تتراوح أسعار سيارات هيونداي توسان المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 و115,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 55,000 و95,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (155 حصان) أو سعة 1.6 لتر تيربو رباعي الأسطوانات (177 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو من 7 سرعات DCT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (2.0L) إلى حوالي 8.5 ثانية (1.6T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي توسان على نحو 65% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على نيسان Qashqai التي تحافظ بنحو 45%، لكنها أقل من كيا سيلتوس التي تحافظ بنحو 61%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 341 فحصاً لسيارة توسان في السعودية. نسبة أضرار الهيكل الخارجي 13.6% ونسبة تآكل الجنوط 6.2% فقط تضعها قريبة من تويوتا RAV4 (14.6% هيكل، 3.4% جنوط) وكيا Sportage (17.4% هيكل، 10.2% جنوط). نسبة أعطال التكييف 0.9% (منخفضة جداً). نسبة البقع الداخلية 13.9% (جيدة/منخفضة). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء. مع هذا الحجم من الفحوصات، يسهل تمييز النماذج الأفضل والأضعف في البيانات.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى كيا سبورتاج، تويوتا راف فور، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"95c:Td16,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي توسان هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (155 حصان) أو سعة 1.6 لتر تيربو رباعي الأسطوانات (177 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو من 7 سرعات DCT. تتراوح أسعار سيارات هيونداي توسان المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 و115,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 55,000 و95,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (155 حصان) أو سعة 1.6 لتر تيربو رباعي الأسطوانات (177 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو من 7 سرعات DCT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية (2.0L) إلى حوالي 8.5 ثانية (1.6T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي توسان على نحو 65% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على نيسان Qashqai التي تحافظ بنحو 45%، لكنها أقل من كيا سيلتوس التي تحافظ بنحو 61%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 341 فحصاً لسيارة توسان في السعودية. نسبة أضرار الهيكل الخارجي 13.6% ونسبة تآكل الجنوط 6.2% فقط تضعها قريبة من تويوتا RAV4 (14.6% هيكل، 3.4% جنوط) وكيا Sportage (17.4% هيكل، 10.2% جنوط). نسبة أعطال التكييف 0.9% (منخفضة جداً). نسبة البقع الداخلية 13.9% (جيدة/منخفضة). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء. مع هذا الحجم من الفحوصات، يسهل تمييز النماذج الأفضل والأضعف في البيانات.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى كيا سبورتاج، تويوتا راف فور، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"95d:Ta76,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيلي Tugella هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (265 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات جيلي Tugella المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 90,000 و104,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (265 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جيلي Tugella على نحو 62% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 52%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 62 فحصاً أجرتها كارسويتش لسيارة Geely Tugella في السعودية، نسبة أضرار الهيكل الخارجي 10.8%، نسبة ملاحظات المقصورة الداخلية 4.8% (ممتازة)، نسبة تلف الجنوط 5.2%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"95e:Ta76,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيلي Tugella هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (265 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات جيلي Tugella المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 90,000 و104,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (265 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جيلي Tugella على نحو 62% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 52%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 62 فحصاً أجرتها كارسويتش لسيارة Geely Tugella في السعودية، نسبة أضرار الهيكل الخارجي 10.8%، نسبة ملاحظات المقصورة الداخلية 4.8% (ممتازة)، نسبة تلف الجنوط 5.2%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"95f:Tac7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Tundra هي بيك أب كبيرة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا Tundra المستعملة في السعودية عادةً بين 18,000 و205,000 ريال، بحسب الطراز وسنة الصنع.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Tundra على نحو 45% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جي إم سي Canyon التي تحافظ بنحو 52%، كما تقل عن متوسط العلامة البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد F-150، شيفروليه سيلفرادو، ورام 1500 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"960:Tac7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Tundra هي بيك أب كبيرة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا Tundra المستعملة في السعودية عادةً بين 18,000 و205,000 ريال، بحسب الطراز وسنة الصنع.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Tundra على نحو 45% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جي إم سي Canyon التي تحافظ بنحو 52%، كما تقل عن متوسط العلامة البالغ 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد F-150، شيفروليه سيلفرادو، ورام 1500 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"961:Tae0,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشانجان UNI-K هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتستهدف من يريد تصميم سيارة دفع رباعي أوروبية بأسعار علامة صينية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (233 حصان) أو سعة 2.0 لتر هجين خفيف، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات شانجان UNI-K المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 و100,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (233 حصان) أو سعة 2.0 لتر هجين خفيف\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شانجان UNI-K على حوالي 48% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من Geely كولري (56%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى إم جي Hs، جيلي كولراي، وشانجان CS35 Plus عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Changan UNI-K التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 2.1%. نسبة تآكل الجنوط 4.7%. نسبة أضرار الهيكل الخارجي 6.1%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"962:Tae0,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشانجان UNI-K هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتستهدف من يريد تصميم سيارة دفع رباعي أوروبية بأسعار علامة صينية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (233 حصان) أو سعة 2.0 لتر هجين خفيف، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات شانجان UNI-K المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 