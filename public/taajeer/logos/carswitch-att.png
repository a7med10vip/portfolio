cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، أودي A8، ولكزس LS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mercedes S500 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 6.1%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 9.4%. نسبة الجنوط التالفة 18.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8d6:T8a0,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز S500 هي سيارة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر تيربو مزدوج V8 (435 حصان)، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز S500 المستعملة في السعودية عادةً بين 185,000 و380,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر تيربو مزدوج V8 (435 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، أودي A8، ولكزس LS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mercedes S500 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 6.1%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 9.4%. نسبة الجنوط التالفة 18.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8d7:Ta78,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز S550 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم فخامة S-Class وقوة محرك V8 ضمن سيدان رائدة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات، سعة 2.0 لتر تيربو رباعي الأسطوانات خطي، أو سعة 3.0 M256، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز S550 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو رباعي الأسطوانات، سعة 2.0 لتر تيربو رباعي الأسطوانات خطي، أو سعة 3.0 M256\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، C200)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (C200 2.0L) إلى حوالي 4.9 ثانية (E300 3.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-250 كم/س بحسب الطراز\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز S550 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي A8 التي تحافظ بنحو 30%، لكنها أقل من بي إم دبليو الفئة 7 التي تحافظ بنحو 45%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، أودي A8، ولكزس LS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8d8:Ta78,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز S550 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم فخامة S-Class وقوة محرك V8 ضمن سيدان رائدة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات، سعة 2.0 لتر تيربو رباعي الأسطوانات خطي، أو سعة 3.0 M256، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز S550 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u0