%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 217 فحصاً لسيارة لاند كروزر في السعودية. بلغت نسبة أضرار الهيكل الخارجي 5.0% فقط، وهي نتيجة استثنائية وأقل من أي مركبة مماثلة في أي فئة. نسبة تآكل الجنوط قريبة من الصفر (3.8%). نسبة البقع الداخلية 7.5% (جيدة/منخفضة). تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، لكزس LX، وجي إم سي يوكون عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"801:T83c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازيراتي Levante هي سيارة رياضية متعددة الاستخدامات فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم بديلاً إيطالياً مميزاً للمنافسين الألمان والبريطانيين. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (580 حصان، Trofeo)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (580 حصان، Trofeo)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية (350 حصان) إلى حوالي 4.1 ثانية (Trofeo V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 264-300 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون توفرها محدوداً في سوق السيارات المستعملة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازيراتي Levante على نحو 34% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بي إم دبليو التي تحافظ بنحو 45%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش، بي إم دبليو، ومرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"802:T83c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازيراتي Levante هي سيارة رياضية متعددة الاستخدامات فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم بديلاً إيطالياً مميزاً للمنافسين الألمان والبريطانيين. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (580 حصان، Trofeo)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (580 حصان، Trofeo)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.6 ثانية (350 حصان) إلى حوالي 4.1 ثانية (Trofeo V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 264-300 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون توفرها محدوداً في سوق السيارات المستعملة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازيراتي Levante على نحو 34% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بي إم دبليو التي تحافظ بنحو 45%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش، بي إم دبليو، ومرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"803:T8ce,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر LR2 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم خياراً مناسب السعر ضمن فئة الكروس أوفر الفاخرة المدمجة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Si4 تيربو رباعي الأسطوانات (240 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات لاند روفر LR2 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 380,000 و860,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 215,000 و345,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Si4 تيربو رباعي الأسطوانات (240 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، أودي Q5، ورينج روفر إيفوك عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"804:T8ce,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر LR2 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم خياراً مناسب السعر ضمن فئة الكروس أوفر الفاخرة المدمجة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Si4 تيربو رباعي الأسطوانات (240 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات لاند روفر LR2 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 380,000 و860,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 215,000 و345,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Si4 تيربو رباعي الأسطوانات (240 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u