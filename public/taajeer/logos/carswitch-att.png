ر بسحب طبيعي V8 (383 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 16.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس LX570 على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي Q8 التي تحافظ بنحو 38%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا لاند كروزر، نيسان باترول، ورينج روفر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"812:T914,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس LX570 هي سيارة رياضية متعددة الاستخدامات فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجذب المشترين الباحثين عن أقصى درجات الاعتمادية، وقوة محرك V8، وجودة مقصورة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 5.7 لتر بسحب طبيعي V8 (383 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لكزس LX570 المستعملة بعمر خمس إلى ست سنوات في السعودية بين 300,000 و325,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003