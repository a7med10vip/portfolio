ً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Escort على نحو 37% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"71e:T8fe,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد Escort هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر EcoBoost تيربو رباعي الأسطوانات (180 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات فورد Escort المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 95,000 و160,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و135,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر EcoBoost تيربو رباعي الأسطوانات (180 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Escort على نحو 37% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"71f:T988,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد Everest هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 3.0 لتر EcoBoost V6 بنزين (400 حصان، Platinum)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات فورد Everest المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 140,000 و160,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 3.0 لتر EcoBoost V6 بنزين (400 حصان، Platinum)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Everest على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من نيسان باثفايندر (31%) وأقل من هيونداي سانتا في (55%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، نيسان باثفايندر، وهيونداي سانتافي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"720:T988,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد Everest هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 3.0 لتر EcoBoost V6 بنزين (400 حصان، Platinum)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات فورد Everest المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 140,000 و160,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 3.0 لتر EcoBoost V6 بنزين (400 حصان، Platinum)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Everest على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من نيسان باثفايندر (31%) وأقل من هيونداي سانتا في (55%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، نيسان باثفايندر، وهيونداي سانتافي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"721:T92d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Evoque هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بتصميم سقف عائم لافت. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200 (200 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات رنج روفر Evoque المستعملة بعمر خمس إلى ست سنوات في السعودية بين 95,000 و110,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر إنجينيوم P200 (200 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، P200)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (P200) إلى حوالي 6.7 ثانية (P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 209-215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X1، أودي Q3، ومرسيدس-بنز GLA عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Range Rover Evoque التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.7%..\u003c/p\u003e"])</script><script>self.__next_f.push([1,"722:T92d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Evoque هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بتصميم سقف عائم لافت. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200 (200 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات رنج روفر Evoque المستعملة بعمر خمس إلى ست سنوات في السعودية بين 95,000 و110,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر إنجينيوم P200 (200 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، P200)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (P200) إلى حوالي 6.7 ثانية (P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 209-215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X1، أودي Q3، ومرسيدس-بنز GLA عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Range Rover Evoque التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.7%..\u003c/p\u003e"])</script><script>self.__next_f.push([1,"723:T712,\u003cp\u003eفولفو EX30 هي كروس أوفر مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي واحد أو محركان كهربائيان متزامنان بمغناطيس دائم (272-428 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي واحد أو محركان كهربائيان متزامنان بمغناطيس دائم (272-428 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.3 ثانية (محركين كهربائيين – فئة الأداء)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل 3، بي واي دي سيل، وبولستار 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e724:T712,\u003cp\u003eفولفو EX30 هي كروس أوفر مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل محرك "])</script><script>self.__next_f.push([1,"كهربائي واحد أو محركان كهربائيان متزامنان بمغناطيس دائم (272-428 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي واحد أو محركان كهربائيان متزامنان بمغناطيس دائم (272-428 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.3 ثانية (محركين كهربائيين – فئة الأداء)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل 3، بي واي دي سيل، وبولستار 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e725:Ta19,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد إكسبيديشن هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر EcoBoost تيربو مزدوج V6 (375-400 حصان)، مع ناقل حركة من 10 سرعات SelectShift أوتوماتيكي. تتراوح أسعار سيارات فورد إكسبيديشن المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 220,000 و290,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 120,000 و145,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر EcoBoost تيربو مزدوج V6 (375-400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 10 سرعات SelectShift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Ford إكسبيديشن على حوالي 38% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من GMC يوكن (46%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى شيفروليه تاهو، جي إم سي يوكون، ونيسان باترول عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Ford Expedition التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 11.9%. نسبة البقع الداخلية 21.3%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"726:Ta19,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد إكسبيديشن هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر EcoBoost تيربو مزدوج V6 (375-400 حصان)، مع ناقل حركة من 10 سرعات SelectShift أوتوماتيكي. تتراوح أسعار سيارات فورد إكسبيديشن المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 220,000 و290,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 120,000 و145,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر EcoBoost تيربو مزدوج V6 (375-400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 10 سرعات SelectShift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Ford إكسبيديشن على حوالي 38% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من GMC يوكن (46%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى شيفروليه تاهو، جي إم سي يوكون، ونيسان باترول عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Ford Expedition التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 11.9%. نسبة البقع الداخلية 21.3%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"727:Tce1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد إكسبلورر هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.3 لتر EcoBoost تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (400 حصان، Platinum/ST)، مع ناقل حركة من 10 سرعات SelectShift أوتوماتيكي. تتراوح أسعار سيارات فورد إكسبلورر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 190,000 و240,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 80,000 و125,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.3 لتر EcoBoost تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (400 حصان، Platinum/ST)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 10 سرعات SelectShift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، 2.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.8 ثانية (2.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد إكسبلورر على نحو 49% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على شيفروليه ترافيرس التي تحافظ بنحو 40%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 211 فحصاً لسيارة إكسبلورر في السعودية. نسبة أضرار الهيكل الخارجي 19.9% ونسبة البقع الداخلية 19.9%. جيب غراند شيروكي (15.1% ملاحظات هيكل، 15.8% ملاحظات داخلية، 1.9% ملاحظات تكييف) تتفوق على إكسبلورر في المقاييس الثلاثة داخل السعودية. أعطال محرك OBD عند 1.4% — قابلة للإدارة مع فحص مناسب. للمشترين الذين يقارنون إكسبلورر بـغراند شيروكي، تدعم بيانات الفحص إكسبلورر باستمرار. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى جي إم سي أكاديا، شيفروليه ترافيرس، وكيا تيلورايد عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"728:Tce1,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد إكسبلورر هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.3 لتر EcoBoost تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (400 حصان، Platinum/ST)، مع ناقل حركة من 10 سرعات SelectShift أوتوماتيكي. تتراوح أسعار سيارات فورد إكسبلورر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 190,000 و240,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 80,000 و125,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.3 لتر EcoBoost تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (400 حصان، Platinum/ST)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 10 سرعات SelectShift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، 2.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.8 ثانية (2.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد إكسبلورر على نحو 49% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على شيفروليه ترافيرس التي تحافظ بنحو 40%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 211 فحصاً لسيارة إكسبلورر في السعودية. نسبة أضرار الهيكل الخارجي 19.9% ونسبة البقع الداخلية 19.9%. جيب غراند شيروكي (15.1% ملاحظات هيكل، 15.8% ملاحظات داخلية، 1.9% ملاحظات تكييف) تتفوق على إكسبلورر في المقاييس الثلاثة داخل السعودية. أعطال محرك OBD عند 1.4% — قابلة للإدارة مع فحص مناسب. للمشترين الذين يقارنون إكسبلورر بـغراند شيروكي، تدعم بيانات الفحص إكسبلورر باستمرار. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى جي إم سي أكاديا، شيفروليه ترافيرس، وكيا تيلورايد عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"729:Tc49,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجاغوار F-Pace هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بديناميكيات القيادة والتصميم البريطاني المميز. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200/P250/P300 تيربو رباعي الأسطوانات أو سعة 5.0 لتر سوبرتشارج V8 (SVR)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات جاغوار F-Pace المستعملة بعمر خمس إلى ست سنوات في السعودية بين 77,000 و226,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر إنجينيوم P200/P250/P300 تيربو رباعي الأسطوانات أو سعة 5.0 لتر سوبرتشارج V8 (SVR)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية (P300) إلى حوالي 4.3 ثانية (SVR 5.0L V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-283 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جاغوار F-Pace على نحو 31% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على لاند روفر Discovery التي تحافظ بنحو 33%، لكنها أقل من لكزس RX350 التي تحافظ بنحو 42%، كما تقل عن متوسط العلامة البالغ 48%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى فحوصات أجرتها كارسويتش لسيارة Jaguar F-Pace في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 15.9% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، أودي Q5، ومرسيدس-بنز GLC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"72a:Tc49,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجاغوار F-Pace هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بديناميكيات القيادة والتصميم البريطاني المميز. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200/P250/P300 تيربو رباعي الأسطوانات أو سعة 5.0 لتر سوبرتشارج V8 (SVR)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات جاغوار F-Pace المستعملة بعمر خمس إلى ست سنوات في السعودية بين 77,000 و226,000 ريال.\u003c/p\u003e\