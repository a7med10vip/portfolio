نية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دونغ فينغ Shine Max على نحو 50% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا كامري التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8fc:T893,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدونغ فينغ Shine Max هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات دونغ فينغ Shine Max المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 50,000 و70,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دونغ فينغ Shine Max على نحو 50% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا كامري التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، ونيسان ألتيما عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8fd:T9f7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجي إم سي سييرا هي بيك أب كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 4.3 لتر V6، سعة 5.3 لتر V8 (355 حصان)، أو سعة 6.2 لتر V8 (420 حصان)، مع ناقل حركة من 8 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات جي إم سي سييرا المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 190,000 و255,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.3 لتر V6، سعة 5.3 لتر V8 (355 حصان)، أو سعة 6.2 لتر V8 (420 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 كم (استهلاك مجمع، 5.3L V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (5.3L V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جي إم سي Sierra على حوالي 57% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من فورد F150 (46%) وأقل من تويوتا Hilux (64%) وأعلى من متوسط جي إم سي البالغ 44%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى شيفروليه سيلفرادو، فورد F-150، ورام 1500 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات GMC Sierra التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 11.1%.\u003c/p\u003e\n\u003cp\u003eنسبة البقع الداخلية 2.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8fe:T9f7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجي إم سي سييرا هي بيك أب كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 4.3 لتر V6، سعة 5.3 لتر V8 (355 حصان)، أو سعة 6.2 لتر V8 (420 حصان)، مع ناقل حركة من 8 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات جي إم سي سييرا المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 190,000 و255,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u