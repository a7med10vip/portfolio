03e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات 7G-ترونيك أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 225 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز GLK350 على نحو 36% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بي إم دبليو X3 التي تحافظ بنحو 38%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، أودي Q5، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"774:T862,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز GLK350 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين سعر مناسب ومحرك V6 بتنفس طبيعي. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (302 حصان)، مع ناقل حركة من 7 سرعات 7G-ترونيك أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (302 حصان)\u0