نداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"881:Tbdc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q3 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتناسب من يبحث عن جودة علامة ألمانية ضمن حجم أصغر وأكثر سهولة في الاستخدام. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات، مع ناقل حركة من 6 سرعات S tronic أو من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي Q3 المستعملة في السعودية عادةً بين 60,000 و115,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات S tronic أو من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية لفئة 1.4T إلى حوالي 7.0 ثانية لفئة 2.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي Q3 على نحو 39% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X3 التي تحافظ بنحو 34%، لكنها أقل من بي إم دبليو X2 التي تحافظ بنحو 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 28 فحصاً لسيارة أودي Q3 في السعودية. نسبة البقع الداخلية 0.0%. أضرار الجنوط عند 0.0% — مماثل لـ very rarely (0.0%).معدل المالك الأول 43%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 4.3%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى بي إم دبليو، مرسيدس-بنز، لكزس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"882:Tbdc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q3 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتناسب من يبحث عن جودة علامة ألمانية ضمن حجم أصغر وأكثر سهولة في الاستخدام. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات، مع ناقل حركة من 6 سرعات S tronic أو من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي Q3 المستعملة في السعودية عادةً بين 60,000 و115,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر TFSI تيربو رباعي الأسطوانات أو سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات S tronic أو من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية لفئة 1.4T إلى حوالي 7.0 ثانية لفئة 2.0T quattro\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي Q3 على نحو 39% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X3 التي تحافظ بنحو 34%، لكنها أقل من بي إم دبليو X2 التي تحافظ بنحو 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 28 فحصاً لسيارة أودي Q3 في السعودية. نسبة البقع الداخلية 0.0%. أضرار الجنوط عند 0.0% — مماثل لـ very rarely (0.0%).معدل المالك الأول 43%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 4.3%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى بي إم دبليو، مرسيدس-بنز، لكزس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"883:T719,\u003cp\u003eإنفينيتي Q30 هي هاتشباك مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتستفيد من منصة مرسيدس ضمن هاتشباك فاخرة مدمجة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر تيربو رباعي الأسطوانات أو سعة 2.0 لتر تيربو رباعي الأسطوانات، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر تيربو رباعي الأسطوانات أو سعة 2.0 لتر تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstro