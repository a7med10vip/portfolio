l\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هافال Dargo على حوالي 49% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من هوندا Cr-V (45%) وأقل من نيسان إكس-تريل (50%)، وهو أقل من متوسط علامة هافال (51%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d1:Ta93,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيتور Dashing هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات جيتور Dashing المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 75,000 و95,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جيتور Dashing على نحو 48% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جيلي كولراي التي تحافظ بنحو 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 37 فحصاً أجرتها كارسويتش لسيارة Jetour Dashing في السعودية، نسبة أضرار الهيكل الخارجي 6.5%، نسبة ملاحظات المقصورة الداخلية 5.4% (ممتازة)، نسبة تلف الجنوط 5.4%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى إم جي Hs، جيلي كولراي، وشانجان CS35 Plus عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d2:Ta93,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيتور Dashing هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات جيتور Dashing المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 75,000 و95,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جيتور Dashing على نحو 48% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جيلي كولراي التي تحافظ بنحو 56%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 37 فحصاً أجرتها كارسويتش لسيارة Jetour Dashing في السعودية، نسبة أضرار الهيكل الخارجي 6.5%، نسبة ملاحظات المقصورة الداخلية 5.4% (ممتازة)، نسبة تلف الجنوط 5.4%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى إم جي Hs، جيلي كولراي، وشانجان CS35 Plus عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d3:Tcb7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر ديفندر هي سيارة فاخرة هجينة متوفرة في سوق السيارات المستعملة في السعودية. ويتزايد الطلب عليها بفضل قدراتها القوية وجودة مقصورتها العصرية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر P300 تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر P400 هجين خفيف سداسي الأسطوانات خطي (400 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لاند روفر ديفندر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 365,000 و435,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 305,000 و335,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر P300 تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر P400 هجين خفيف سداسي الأسطوانات خطي (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية (P300 90) إلى حوالي 6.0 ثانية (P400)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 191-209 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لاند روفر ديفندر على نحو 55% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على لكزس LX570 التي تحافظ بنحو 56%، لكنها أقل من لكزس LX600 التي تحافظ بنحو 69%، كما تتفوق على متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Land Rover Defender التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 1.8% — أقل من very rarely (1.8%) وvery rarely (1.8%). نسبة تآكل الجنوط 1.8%. نسبة أضرار الهيكل الخارجي 5.1%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، جيب، مرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d4:Tcb7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر ديفندر هي سيارة فاخرة هجينة متوفرة في سوق السيارات المستعملة في السعودية. ويتزايد الطلب عليها بفضل قدراتها القوية وجودة مقصورتها العصرية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر P300 تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر P400 هجين خفيف سداسي الأسطوانات خطي (400 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لاند روفر ديفندر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 365,000 و435,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 305,000 و335,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر P300 تيربو رباعي الأسطوانات (300 حصان) أو سعة 3.0 لتر P400 هجين خفيف سداسي الأسطوانات خطي (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية (P300 90) إلى حوالي 6.0 ثانية (P400)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 191-209 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لاند روفر ديفندر على نحو 55% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على لكزس LX570 التي تحافظ بنحو 56%، لكنها أقل من لكزس LX600 التي تحافظ بنحو 69%، كما تتفوق على متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Land Rover Defender التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 1.8% — أقل من very rarely (1.8%) وvery rarely (1.8%). نسبة تآكل الجنوط 1.8%. نسبة أضرار الهيكل الخارجي 5.1%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، جيب، مرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d5:Ta80,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر Discovery هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على الطرق الوعرة وراحة عائلية لسبعة ركاب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر P360 هجين خفيف سداسي الأسطوانات خطي (360 حصان) أو سعة 3.0 لتر ديزل تيربو سداسي الأسطوانات خطي، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لاند روفر Discovery المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 380,000 و860,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 215,000 و345,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر P360 هجين خفيف سداسي الأسطوانات خطي (360 حصان) أو سعة 3.0 لتر ديزل تيربو سداسي الأسطوانات خطي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، P360)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (P360)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لاند روفر Discovery على نحو 33% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من لكزس RX350 التي تحافظ بنحو 42%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، جيب جراند شيروكي، ونيسان باثفايندر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d6:Ta80,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر Discovery هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على الطرق الوعرة وراحة عائلية لسبعة ركاب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر P360 هجين خفيف سداسي الأسطوانات خطي (360 حصان) أو سعة 3.0 لتر ديزل تيربو سداسي الأسطوانات خطي، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لاند روفر Discovery المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 380,000 و860,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 215,000 و345,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر P360 هجين خفيف سداسي الأسطوانات خطي (360 حصان) أو سعة 3.0 لتر ديزل تيربو سداسي الأسطوانات خطي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، P360)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (P360)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لاند روفر Discovery على نحو 33% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من لكزس RX350 التي تحافظ بنحو 42%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، جيب جراند شيروكي، ونيسان باثفايندر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d7:T8be,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر Discovery Sport هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر بخمسة أو سبعة مقاعد مع قدرات حقيقية على مختلف التضاريس. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200 تيربو رباعي الأسطوانات (200 حصان) أو P300 (300 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات لاند روفر Discovery Sport المستعملة في السعودية عادةً بين 45,000 و105,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر إنجينيوم P200 تيربو رباعي الأسطوانات (200 حصان) أو P300 (300 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، P200)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (P200) إلى حوالي 6.5 ثانية (P300)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195-209 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، أودي Q5، ومرسيدس-بنز GLC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6d8:T8be,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلاند روفر Discovery Sport هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر بخمسة أو سبعة مقاعد مع قدرات حقيقية على مختلف التضاريس. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P200 تيربو رباعي الأسطوانات (200 حصان) أو P300 (300 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات لاند روفر Discovery Sport المستعملة في السعودية عادةً بين 45,000 و105,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\