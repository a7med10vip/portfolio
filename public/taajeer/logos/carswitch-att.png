ة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل 3، بي واي دي سيل، وبولستار 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ec:T82a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي سيل 7 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتقدم سيارة دفع رباعي عائلية كهربائية بالكامل مدعومة بهندسة حزمة بطارية Blade Battery عالية الأمان. وتتوفر عادةً بخيارات محرك تشمل مغناطيس دائم مزدوج محركات كهربائية (390 حصان استهلاك مجمع)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e مغناطيس دائم مزدوج محركات كهربائية (390 حصان استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 17.0 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل 3، بي واي دي سيل، وبولستار 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ed:T726,\u003cp\u003eبي واي دي Sealion 5 هي سيدان مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي مغناطيس دائم أحادي (204 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي مغناطيس دائم أحادي (204 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.5 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي واي دي سونغ بلس، كيا سبورتاج، وتويوتا راف فور عند مقارنة الخيارات المتوفرة.\u003c/p\u003e8ee:T726,\u003cp\u003eبي واي دي Sealion 5 هي سيدان مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات م"])</script><script>self.__next_f.push([1,"حرك تشمل محرك كهربائي مغناطيس دائم أحادي (204 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي مغناطيس دائم أحادي (204 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.5 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي واي دي سونغ بلس، كيا سبورتاج، وتويوتا راف فور عند مقارنة الخيارات المتوفرة.\u003c/p\u003e8ef:T835,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي سيليون 7 هي سيارة رياضية متعددة الاستخدامات مدمجة كهربائية عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي أحادي أو مغناطيس دائم مزدوج المحركات الكهربائية (313-390 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي أحادي أو مغناطيس دائم مزدوج المحركات الكهربائية (313-390 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 16.0 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية (محرك مزدوج)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل Y، بي إم دبليو iX3، ومرسيدس-بنز EQB عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f0:T835,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي سيليون 7 هي سيارة رياضية متعددة الاستخدامات مدمجة كهربائية عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي أحادي أو مغناطيس دائم مزدوج المحركات الكهربائية (313-390 حصان)، مع ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي أحادي أو مغناطيس دائم مزدوج المحركات الكهربائية (313-390 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 16.0 كيلوواط ساعة/100 كم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية (محرك مزدوج)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل Y، بي إم دبليو iX3، ومرسيدس-بنز EQB عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f1:Taf7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا سيلتوس هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر تيربو رباعي الأسطوانات (195 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)، مع ناقل حركة من 7 سرعات DCT أو IVT. تتراوح أسعار سيارات كيا سيلتوس المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 70,000 و90,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 45,000 و115,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر تيربو رباعي الأسطوانات (195 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT أو IVT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع، 1.6T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (1.6T DCT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا سيلتوس على نحو 66% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا راف فور التي تحافظ بنحو 56%، كما تتفوق على متوسط العلامة البالغ 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 52 فحصاً لسيارة Kia سيلتوسes في السعودية، نسبة أضرار الهيكل الخارجي 12.3% ونسبة البقع الداخلية 5.9% — مقارنةً بـ و أفضل من هيونداي Creta (15.8% هيكل، 13.8% داخل) وare مماثل لـتويوتا Rav 4 (14.6% هيكل). لا أعطال تكييف مسجلة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هيونداي، نيسان، تويوتا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f2:Taf7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا سيلتوس هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر تيربو رباعي الأسطوانات (195 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)، مع ناقل حركة من 7 سرعات DCT أو IVT. تتراوح أسعار سيارات كيا سيلتوس المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 70,000 و90,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 45,000 و115,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر تيربو رباعي الأسطوانات (195 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT أو IVT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع، 1.6T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (1.6T DCT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا سيلتوس على نحو 66% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا راف فور التي تحافظ بنحو 56%، كما تتفوق على متوسط العلامة البالغ 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 52 فحصاً لسيارة Kia سيلتوسes في السعودية، نسبة أضرار الهيكل الخارجي 12.3% ونسبة البقع الداخلية 5.9% — مقارنةً بـ و أفضل من هيونداي Creta (15.8% هيكل، 13.8% داخل) وare مماثل لـتويوتا Rav 4 (14.6% هيكل). لا أعطال تكييف مسجلة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هيونداي، نيسان، تويوتا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f3:Tb81,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان سنترا هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (110 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان سنترا المستعملة في السعودية عادةً بين 20,000 و30,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (110 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية (1.6L) إلى حوالي 9.5 ثانية (2.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان سنترا على نحو 52% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 42 فحصاً أجرتها كارسويتش لسيارة Nissan Sentra في السعودية، نسبة أضرار الهيكل الخارجي 37.0%، نسبة ملاحظات المقصورة الداخلية 19.5% (متوسطة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f4:Tb81,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان سنترا هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (110 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان سنترا المستعملة في السعودية عادةً بين 20,000 و30,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (110 حصان) أو سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (149 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية (1.6L) إلى حوالي 9.5 ثانية (2.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان سنترا على نحو 52% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 42 فحصاً أجرتها كارسويتش لسيارة Nissan Sentra في السعودية، نسبة أضرار الهيكل الخارجي 37.0%، نسبة ملاحظات المقصورة الداخلية 19.5% (متوسطة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f5:Tb23,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Sequoia هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا Sequoia المستعملة في السعودية عادةً بين 45,000 و75,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 V8 أو 10.0 لتر/100 كم (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8) إلى حوالي 6.0 ثانية (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Sequoia على نحو 46% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد إكسبيديشن التي تحافظ بنحو 38%، لكنها أقل من نيسان باترول التي تحافظ بنحو 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، شيفروليه تاهو، وفورد إكسبيديشن عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f6:Tb23,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Sequoia هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات تويوتا Sequoia المستعملة في السعودية عادةً بين 45,000 و75,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.7 لتر بسحب طبيعي V8 (381 حصان، الجيل الأقدم) أو سعة 3.5 لتر تيربو مزدوج V6 هجين (437 حصان استهلاك مجمع، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 V8 أو 10.0 لتر/100 كم (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (V8) إلى حوالي 6.0 ثانية (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Sequoia على نحو 46% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على فورد إكسبيديشن التي تحافظ بنحو 38%، لكنها أقل من نيسان باترول التي تحافظ بنحو 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، شيفروليه تاهو، وفورد إكسبيديشن عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f7:T81e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي Shark 6 هي بيك أب هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو PHEV مع محركات كهربائية (430 حصان استهلاك مجمع)، مع ناقل حركة أحادي السرعة أو من 2 سرعات صندوق نقل العزم.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو PHEV مع محركات كهربائية (430 حصان استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أحادي السرعة أو من 2 سرعات صندوق نقل العزم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.0 لتر/100 كم (PHEV استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق. لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلكس، فورد رينجر، وميتسوبيشي L200 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f8:T81e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي Shark 6 هي بيك أب هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو PHEV مع محركات كهربائية (430 حصان استهلاك مجمع)، مع ناقل حركة أحادي السرعة أو من 2 سرعات صندوق نقل العزم.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو PHEV مع محركات كهربائية (430 حصان استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أحادي السرعة أو من 2 سرعات صندوق نقل العزم\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.0 لتر/100 كم (PHEV استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق. لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلكس، فورد رينجر، وميتسوبيشي L200 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8f9:T955,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدونغ فينغ Shine هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات دونغ فينغ Shine المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 50,000 و55,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دونغ فينغ Shine على نحو 53% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8fa:T955,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدونغ فينغ Shine هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات دونغ فينغ Shine المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 50,000 و55,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003c