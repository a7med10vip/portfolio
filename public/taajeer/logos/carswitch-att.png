ong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز V300 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا كارنفال التي تحافظ بنحو 42%، لكنها أقل من تويوتا جرانفيا التي تحافظ بنحو 46%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا جرانفيا، هيونداي ستاريا، وكيا كارنفال عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"974:T96a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز V300 هي سيارة عائلية متعددة الاستخدامات فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين أداء ثنائي التيربو وأفخم مقصورة ضمن فئة الفانات. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر ديزل توربو مزدوج سداسي الأسطوانات خطي (239 حصان)، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز V300 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر ديزل توربو مزدوج سداسي الأسطوانات خطي (239 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز V300 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا كارنفال التي تحافظ بنحو 42%، لكنها أقل من تويوتا جرانفيا التي تحافظ بنحو 46%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا جرانفيا، هيونداي ستاريا، وكيا كارنفال عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"975:Tb49,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Velar هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بتصميم خارجي انسيابي خالٍ من البروزات ومقصورة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P250 (250 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات رنج روفر Velar المستعملة بعمر خمس إلى ست سنوات في السعودية بين 155,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر إنجينيوم P250 (250 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، P250)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.3 ثانية (P250)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 214-216 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 32 فحصاً أجرتها كارسويتش لسيارة Range Rover Velar في السعودية، نسبة أضرار الهيكل الخارجي 8.1%، نسبة ملاحظات المقصورة الداخلية 6.2% (ممتازة)، نسبة تلف الجنوط 12.9%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش Macan، بي إم دبليو X4، ومرسيدس-بنز GLC كوبيه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"976:Tb49,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرنج روفر Velar هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بتصميم خارجي انسيابي خالٍ من البروزات ومقصورة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر إنجينيوم P250 (250 حصان) أو P300 (300 حصان) تيربو رباعي الأسطوانات، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF. تتراوح أسعار سيارات رنج روفر Velar المستعملة بعمر خمس إلى ست سنوات في السعودية بين 155,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات ال