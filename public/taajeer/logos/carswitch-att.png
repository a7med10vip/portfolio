u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي Genesis على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط هيونداي البالغ 51%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"74c:T8cd,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي جينيسيس هي سيدان فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتوفر خيارات محركات V6 وV8 بأسعار سيارات مستعملة مناسبة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.8 لتر بسحب طبيعي V6 (315 حصان) أو سعة 5.0 لتر Tau V8 (429 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات هيونداي جينيسيس المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 190,000 و220,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.8 لتر بسحب طبيعي V6 (315 حصان) أو سعة 5.0 لتر Tau V8 (429 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6) إلى حوالي 5.5 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي Genesis على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط هيونداي البالغ 51%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"74d:T768,\u003cp\u003eمازيراتي Ghibli هي سيدان متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (330-430 حصان بحسب في tune)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (330-430 حصان بحسب في tune)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (Ghibli S Q4)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-286 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازيراتي Ghibli على نحو 35% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من لكزس RX350 التي تحافظ بنحو 42%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش، بي إم دبليو، ومرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e74e:T768,\u003cp\u003eمازيراتي Ghibli هي سيدان متوفرة في سوق السيارات المستعملة في السعودية. وتت"])</script><script>self.__next_f.push([1,"وفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (330-430 حصان بحسب في tune)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (330-430 حصان بحسب في tune)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع، 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (Ghibli S Q4)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-286 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازيراتي Ghibli على نحو 35% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من لكزس RX350 التي تحافظ بنحو 42%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش، بي إم دبليو، ومرسيدس-بنز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e74f:T89b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eألفا روميو Giulia هي سيدان عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (280 حصان) أو سعة 2.9 لتر تيربو مزدوج V6 (510 حصان، Quadrifoglio)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (280 حصان) أو سعة 2.9 لتر تيربو مزدوج V6 (510 حصان، Quadrifoglio)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (2.0T) إلى حوالي 3.9 ثانية (QV)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-307 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ ألفا روميو Giulia على نحو 50% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"750:T89b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eألفا روميو Giulia هي سيدان عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (280 حصان) أو سعة 2.9 لتر تيربو مزدوج V6 (510 حصان، Quadrifoglio)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (280 حصان) أو سعة 2.9 لتر تيربو مزدوج V6 (510 حصان، Quadrifoglio)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (2.0T) إلى حوالي 3.9 ثانية (QV)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-307 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً