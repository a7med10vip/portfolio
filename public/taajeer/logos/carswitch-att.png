rong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.2 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بمقصورة عملية ومساحة مناسبة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو 435 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من أودي A5 التي تحافظ بنحو 49%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي A5، مرسيدس-بنز CLE، ولكزس RC عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5c8:T8fa,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو 435 هي كوبيه فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداء 306 حصان من محرك سداسي الأسطوانات مستقيم ضمن هيكل كوبيه عملي بأربعة أبواب. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (306 حصان)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو 435 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و235,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e س