3e\n\u003cp\u003eاستناداً إلى 65 فحصاً أجرتها كارسويتش لسيارة Audi A8 في السعودية، نسبة أضرار الهيكل الخارجي 35.3%، نسبة البقع الداخلية 23.4% (متوسطة)، نسبة تلف الجنوط 22.6%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 7، مرسيدس-بنز الفئة S، ولكزس LS عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"60f:T9ef,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجي إم سي أكاديا هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6 (281 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات جي إم سي أكاديا المستعملة في السعودية عادةً بين 19,000 و30,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6 (281 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 190 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جي إم سي أكاديا على نحو 29% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من شيفروليه ترافيرس التي تحافظ بنحو 40%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات GMC Acadia التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 25.4%. نسبة أعطال التكييف 8.5%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى فورد، شيفروليه، هيونداي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"610:T9ef,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجي إم سي أكاديا هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6 (281 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات جي إم سي أكاديا المستعملة في السعودية عادةً بين 19,000 و30,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6 (281 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 190 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جي إم سي أكاديا على نحو 29% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من شيفروليه ترافيرس التي تحافظ بنحو 40%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات GMC Acadia التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 25.4%. نسبة أعطال التكييف 8.5%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى فورد، شيفروليه، هيونداي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"611:T947,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي أكسنت هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (123 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات هيونداي أكسنت المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 50,000 و65,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و155,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (123 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.5 ثانية (1.6L) إلى حوالي 13.0 ثانية (1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي أكسنت على نحو 64% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا يارس التي تحافظ بنحو 63%، لكنها أقل من نيسان صني التي تحافظ بنحو 68%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وكيا ريو عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"612:T947,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهيونداي أكسنت هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (123 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات هيونداي أكسنت المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 50,000 و65,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و155,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (123 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.5 ثانية (1.6L) إلى حوالي 13.0 ثانية (1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ هيونداي أكسنت على نحو 64% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا يارس التي تحافظ بنحو 63%، لكنها أقل من نيسان صني التي تحافظ بنحو 68%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وكيا ريو عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"613:Tc6d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهوندا أكورد هي سيدان متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر VTEC تيربو (192 حصان)، سعة 2.0 لتر VTEC تيربو (252 حصان)، أو سعة 3.5 لتر بسحب طبيعي V6، مع ناقل حركة CVT، من 10 سرعات أوتوماتيكي، أو من 6 سرعات يدوي. تتراوح أسعار سيارات هوندا أكورد المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 120,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر VTEC تيربو (192 حصان)، سعة 2.0 لتر VTEC تيربو (252 حصان)، أو سعة 3.5 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT، من 10 سرعات أوتوماتيكي، أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 1.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (1.5T) إلى حوالي 5.8 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Honda أكورد على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من نيسان Altima (41%) وأقل من تويوتا Avalon (65%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 137 فحصاً لسيارة أكورد في السعودية. نسبة أضرار الهيكل الخارجي 18.5% ونسبة البقع الداخلية 8.1%. نسبة أعطال التكييف 0.7% . مقارنةً بـتويوتا Camry في السعودية (هيكل 24.7%، داخل 15.1%)، تصل هذه السيارة بحالة أفضل أو مماثلة في الهيكل الخارجي. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، نيسان ألتيما، ومازدا 6 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"614:Tc6d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهوندا أكورد هي سيدان متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر VTEC تيربو (192 حصان)، سعة 2.0 لتر VTEC تيربو (252 حصان)، أو سعة 3.5 لتر بسحب طبيعي V6، مع ناقل حركة CVT، من 10 سرعات أوتوماتيكي، أو من 6 سرعات يدوي. تتراوح أسعار سيارات هوندا أكورد المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 120,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر VTEC تيربو (192 حصان)، سعة 2.0 لتر VTEC تيربو (252 حصان)، أو سعة 3.5 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT، من 10 سرعات أوتوماتيكي، أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع، 1.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.0 ثانية (1.5T) إلى حوالي 5.8 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Honda أكورد على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من نيسان Altima (41%) وأقل من تويوتا Avalon (65%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 137 فحصاً لسيارة أكورد في السعودية. نسبة أضرار الهيكل الخارجي 18.5% ونسبة البقع الداخلية 8.1%. نسبة أعطال التكييف 0.7% . مقارنةً بـتويوتا Camry في السعودية (هيكل 24.7%، داخل 15.1%)، تصل هذه السيارة بحالة أفضل أو مماثلة في الهيكل الخارجي. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، نيسان ألتيما، ومازدا 6 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"615:Ta28,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلوسيد إير هي سيدان فاخرة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتمثل سيارة كهربائية أمريكية فاخرة تترك بصمتها في سوق السيارات الكهربائية المتنامي. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي واحد أو محركان كهربائيان بمغناطيس دائم (480-1,111 حصان بحسب الفئة)، مع ناقل حركة أحادي السرعة. تتراوح أسعار سيارات لوسيد إير المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 215,000 و390,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي واحد أو محركان كهربائيان بمغناطيس دائم (480-1,111 حصان بحسب الفئة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 كيلوواط ساعة/100 كم (Air Gr وTouring)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.0 ثانية (Air GT Performance)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لوسيد إير على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بورش Taycan التي تحافظ بنحو 59%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل S، بورش Taycan، ومرسيدس-بنز EQE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"616:Ta28,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلوسيد إير هي سيدان فاخرة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتمثل سيارة كهربائية أمريكية فاخرة تترك بصمتها في سوق السيارات الكهربائية المتنامي. وتتوفر عادةً بخيارات محرك تشمل محرك كهربائي واحد أو محركان كهربائيان بمغناطيس دائم (480-1,111 حصان بحسب الفئة)، مع ناقل حركة أحادي السرعة. تتراوح أسعار سيارات لوسيد إير المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 215,000 و390,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e محرك كهربائي واحد أو محركان كهربائيان بمغناطيس دائم (480-1,111 حصان بحسب الفئة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 كيلوواط ساعة/100 كم (Air Gr وTouring)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.0 ثانية (Air GT Performance)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 270 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لوسيد إير على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بورش Taycan التي تحافظ بنحو 59%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تسلا موديل S، بورش Taycan، ومرسيدس-بنز EQE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"617:Ta17,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشانجان Alsvin هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر والتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (101 حصان)، مع ناقل حركة يدوي من 5 سرعات أو CVT أوتوماتيكي. تتراوح أسعار سيارات شانجان Alsvin المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 30,000 و35,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 25,000 و80,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (101 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 5 سرعات أو CVT أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شانجان Alsvin على حوالي 55% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هوندا Civic (57%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Changan Alsvin التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 13.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"618:Ta17,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشانجان Alsvin هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر والتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (101 حصان)، مع ناقل حركة يدوي من 5 سرعات أو CVT أوتوماتيكي. تتراوح أسعار سيارات شانجان Alsvin المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 30,000 و35,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 25,000 و80,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (101 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 5 سرعات أو CVT أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 11.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شانجان Alsvin على حوالي 55% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هوندا Civic (57%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Changan Alsvin التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 13.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"619:T8f8,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان ألتيما هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (182 حصان) أو سعة 2.0 لتر VC-تيربو (248 حصان، الجيل الحالي)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان ألتيما المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 105,000 و120,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و75,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (182 حصان) أو سعة 2.0 لتر VC-تيربو (248 حصان، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، وهيونداي سوناتا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61a:T8f8,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان ألتيما هي سيدان متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (182 حصان) أو سعة 2.0 لتر VC-تيربو (248 حصان، الجيل الحالي)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان ألتيما المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 105,000 و120,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و75,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (182 حصان) أو سعة 2.0 لتر VC-تيربو (248 حصان، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كامري، هوندا أكورد، وهيونداي سوناتا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61b:T901,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز AMG GT63 هي كوبيه عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر AMG تيربو مزدوج V8 (630 حصان، GT63 S)، مع ناقل حركة من 9 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز AMG GT63 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر AMG تيربو مزدوج V8 (630 حصان، GT63 S)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.2 ثانية (GT63 S 4MATIC+)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 315 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز AMG GT63 على نحو 39% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من أودي RS7 التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش Panamera، أودي RS7، وبي إم دبليو M8 جران كوبيه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61c:T901,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز AMG GT63 هي كوبيه عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر AMG تيربو مزدوج V8 (630 حصان، GT63 S)، مع ناقل حركة من 9 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز AMG GT63 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر AMG تيربو مزدوج V8 (630 حصان، GT63 S)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.2 ثانية (GT63 S 4MATIC+)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 315 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز AMG GT63 على نحو 39% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من أودي RS7 التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش Panamera، أودي RS7، وبي إم دبليو M8 جران كوبيه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61d:T8b5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرينو Arkana هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات (140-155 حصان)، مع ناقل حركة من 7 سرعات EDC مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات رينو Arkana المستعملة في السعودية عادةً بين 95,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو رباعي الأسطوانات (140-155 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات EDC مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ رينو Arkana على نحو 46% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا C-Hr التي تحافظ بنحو 52%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا C-Hr، مازدا CX-30، وهيونداي كونا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61e:T8b5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eرينو Arkana هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو رباعي الأسطوانات (140-155 حصان)، مع ناقل حركة من 7 سرعات EDC مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات رينو Arkana المستعملة في السعودية عادةً بين 95,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو رباعي الأسطوانات (140-155 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات EDC مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ رينو Arkana على نحو 46% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا C-Hr التي تحافظ بنحو 52%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا C-Hr، مازدا CX-30، وهيونداي كونا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"61f:T85b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Armada هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات. تتراوح أسعار سيارات نيسان Armada المستعملة في السعودية عادةً بين 20,000 و35,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان Armada على نحو 39% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جي إم سي يوكون التي تحافظ بنحو 46%، كما تقل عن متوسط العلامة البالغ 55%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، تويوتا لاند كروزر، وجي إم سي يوكون عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"620:T85b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Armada هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات. تتراوح أسعار سيارات نيسان Armada المستعملة في السعودية عادةً بين 20,000 و35,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان Armada على نحو 39% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من جي إم سي يوكون التي تحافظ بنحو 46%، كما تقل عن متوسط العلامة البالغ 55%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، تويوتا لاند كروزر، وجي إم سي يوكون عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"621:T9ed,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيري Arrizo 5 Pro هي سيدان مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم اتصالاً محسناً لنظام المعلومات والترفيه وتسارعاً سريعاً بمحرك تيربو ضمن فئة السيدان اليومية المناسبة السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة CVT أو من 6 سرعات يدوي. تتراوح أسعار سيارات شيري Arrizo 5 Pro المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 30,000 و60,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شيري Arrizo 5 Pro على نحو 54% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من هوندا سيفيك التي تحافظ بنحو 57%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا، هوندا سيفيك، وهيونداي إلنترا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"622:T9ed,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيري Arrizo 5 Pro هي سيدان مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم اتصالاً محسناً لنظام المعلومات والترفيه وتسارعاً سريعاً بمحرك تيربو ضمن فئة السيدان اليومية المناسبة السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة CVT أو من 6 سرعات يدوي. تتراوح أسعار سيارات شيري Arrizo 5 Pro المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 30,000 و60,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 6 سرعات يدوي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا و