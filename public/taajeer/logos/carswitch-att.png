دية عادةً بين 490,000 و540,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر تيربو مزدوج V6 (415 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس LX600 على حوالي 60% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من أودي Q8 (38%) وأعلى من متوسط لكزس البالغ 50%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا لاند كروزر، نيسان باترول، ورينج روفر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"814:T91a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس LX600 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتعد الخيار الرائد في سوق سيارات الدفع الرباعي الفاخرة المستعملة، مع أسعار تتجاوز معظم المنافسين. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر تيربو مزدوج V6 (415 حصان)، مع ناقل حركة أوتوماتيكي من 10 سرعات. تتراوح أسعار سيارات لكزس LX600 المستعملة في السعودية عادةً بين 490,000 و540,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر تيربو مزدوج V6 (415 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e سعر الشراء مرتفع مقارنةً ببعض البدائل في الفئة. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس LX600 على حوالي 60% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من أودي Q8 (38%) وأعلى من متوسط لكزس البالغ 50%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا لاند كروزر، نيسان باترول، ورينج روفر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"815:T983,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو M2 هي كوبيه مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي (460 حصان، الجيل الحالي G87)، مع ناقل حركة يدوي من 6 سرعات أو من 8 سرعات M Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو M2 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و235,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي (460 حصان، الجيل الحالي G87)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو من 8 سرعات M Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.3 ثانية (أوتوماتيكي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً، 285 كم/س M Driver Package)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو M2 على نحو 59% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد موستانج، شيفروليه كامارو، ودودج تشالنجر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"816:T983,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو M2 هي كوبيه مدمجة عا