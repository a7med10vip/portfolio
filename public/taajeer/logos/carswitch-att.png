003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، ومرسيدس-بنز GLE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Infiniti QX60 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.3%. نسبة البقع الداخلية 25.0%..\u003c/p\u003e"])</script><script>self.__next_f.push([1,"89e:T85a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي QX60 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم جودة مقصورة بمستوى لكزس RX بأسعار أقل. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، ومرسيدس-بنز GLE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Infiniti QX60 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.3%. نسبة البقع الداخلية 25.0%..\u003c/p\u003e"])</script><script>self.__next_f.push([1,"89f:T992,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي QX70 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.7 لتر بسحب طبيعي V6 (328 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (390 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.7 لتر بسحب طبيعي V6 (328 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (390 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6) إلى حوالي 5.8 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات. قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 21 فحصاً أجرتها كارسويتش لسيارة Infiniti QX70 في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 13.4% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X4، بورش ماكان، ومرسيدس-بنز GLC كوبيه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a0:T992,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي QX70 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.7 لتر بسحب طبيعي V6 (328 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (390 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.7 لتر بسحب طبيعي V6 (328 حصان) أو سعة 5.0 لتر بسحب طبيعي V8 (390 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6) إلى حوالي 5.8 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات. قد تتطلب الأنظمة الإلكترونية والتقنيات المتقدمة عناية إضافية وتكاليف إصلاح أعلى.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 21 فحصاً أجرتها كارسويتش لسيارة Infiniti QX70 في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 13.4% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X4، بورش ماكان، ومرسيدس-بنز GLC كوبيه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a1:Ta42,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي QX80 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قوة محرك V8 وجودة مقصورة فاخرة بأسعار أقل من سيارات مرسيدس-بنز GLS المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي QX80 على نحو 42% من قيمتها الأصلية بعد 5 سنوات، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 24 فحصاً أجرتها كارسويتش لسيارة Infiniti QX80 في السعودية، نسبة أضرار الهيكل الخارجي 9.3%، نسبة ملاحظات المقصورة الداخلية 16.7% (جيدة)، نسبة تلف الجنوط 4.2%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، تويوتا لاند كروزر، وجي إم سي يوكون عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a2:Ta42,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي QX80 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قوة محرك V8 وجودة مقصورة فاخرة بأسعار أقل من سيارات مرسيدس-بنز GLS المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي QX80 على نحو 42% من قيمتها الأصلية بعد 5 سنوات، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 24 فحصاً أجرتها كارسويتش لسيارة Infiniti QX80 في السعودية، نسبة أضرار الهيكل الخارجي 9.3%، نسبة ملاحظات المقصورة الداخلية 16.7% (جيدة)، نسبة تلف الجنوط 4.2%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان باترول، تويوتا لاند كروزر، وجي إم سي يوكون عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a3:T992,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا رايز هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.0 لتر تيربو ثلاثي الأسطوانات (98 حصان)، مع ناقل حركة CVT أو Direct Shift CVT. تتراوح أسعار سيارات تويوتا رايز المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 45,000 و70,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.0 لتر تيربو ثلاثي الأسطوانات (98 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا رايز على نحو 67% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا سيلتوس التي تحافظ بنحو 66%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 55 فحصاً أجرتها كارسويتش لسيارة Toyota Raize في السعودية، نسبة أضرار الهيكل الخارجي 12.5% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a4:T992,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا رايز هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.0 لتر تيربو ثلاثي الأسطوانات (98 حصان)، مع ناقل حركة CVT أو Direct Shift CVT. تتراوح أسعار سيارات تويوتا رايز المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 45,000 و70,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.0 لتر تيربو ثلاثي الأسطوانات (98 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا رايز على نحو 67% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على كيا سيلتوس التي تحافظ بنحو 66%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 55 فحصاً أجرتها كارسويتش لسيارة Toyota Raize في السعودية، نسبة أضرار الهيكل الخارجي 12.5% (جيدة).\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a5:T83c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدودج Ram هي بيك أب كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات محرك V8 ومقصورة بيك أب مريحة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر بنتاستار V6 أو سعة 5.7 لتر HEMI V8، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات دودج Ram المستعملة في السعودية عادةً بين 40,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر بنتاستار V6 أو سعة 5.7 لتر HEMI V8\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (5.7L HEMI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Ram على نحو 41% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على شيفروليه سيلفرادو التي تحافظ بنحو 40%، لكنها أقل من فورد F-150 التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد F-150، شيفروليه سيلفرادو، ورام 1500 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a6:T83c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدودج Ram هي بيك أب كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات محرك V8 ومقصورة بيك أب مريحة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر بنتاستار V6 أو سعة 5.7 لتر HEMI V8، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات دودج Ram المستعملة في السعودية عادةً بين 40,000 و160,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر بنتاستار V6 أو سعة 5.7 لتر HEMI V8\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (5.7L HEMI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Ram على نحو 41% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على شيفروليه سيلفرادو التي تحافظ بنحو 40%، لكنها أقل من فورد F-150 التي تحافظ بنحو 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد F-150، شيفروليه سيلفرادو، ورام 1500 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a7:T912,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد رينجر هي بيك أب متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 2.3 لتر EcoBoost تيربو بنزين (285 حصان، Raptor)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات فورد رينجر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 165,000 و230,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 45,000 و45,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 2.3 لتر EcoBoost تيربو بنزين (285 حصان، Raptor)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية (2.0L ديزل Wildtrak)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175-200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد رينجر على نحو 33% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من نيسان نافارا التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هيلوكس، نيسان نافارا، وميتسوبيشي L200 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a8:T912,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد رينجر هي بيك أب متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 2.3 لتر EcoBoost تيربو بنزين (285 حصان، Raptor)، مع ناقل حركة من 6 سرعات أو من 10 سرعات أوتوماتيكي. تتراوح أسعار سيارات فورد رينجر المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 165,000 و230,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 45,000 و45,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر Bi-turbo ديزل (210 حصان) أو سعة 2.3 لتر EcoBoost تيربو بنزين (285 حصان، Raptor)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 10 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0L ديزل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية (2.0L ديزل Wildtrak)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175-200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد رينجر على نحو 33% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من نيسان نافارا التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هيلوكس، نيسان نافارا، وميتسوبيشي L200 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8a9:T949,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد رينجر Raptor هي بيك أب متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (397 حصان)، مع ناقل حركة أوتوماتيكي من 10 سرعات. تتراوح أسعار سيارات فورد رينجر Raptor المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 95,000 و160,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و135,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (397 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Ford رينجر Raptor على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا Tundra (45%) وأقل من تويوتا Hilux (64%) وأعلى من متوسط فورد البالغ 37%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلكس، فورد رينجر، ونيسان نافارا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8aa:T949,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد رينجر Raptor هي بيك أب متوسطة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (397 حصان)، مع ناقل حركة أوتوماتيكي من 10 سرعات. تتراوح أسعار سيارات فورد رينجر Raptor المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 95,000 و160,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و135,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر EcoBoost تيربو مزدوج V6 (397 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 10 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ Ford رينجر Raptor على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا Tundra (45%) وأقل من تويوتا Hilux (64%) وأعلى من متوسط فورد البالغ 37%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلكس، فورد رينجر، ونيسان نافارا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ab:Tcd2,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Rav 4 هي كروس أوفر مدمجة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 2.5 لتر هجين (219 حصان بإجمالي قوة)، مع ناقل حركة أوتوماتيكي من 8 سرعات أو e-CVT (هجين). تتراوح أسعار سيارات تويوتا Rav 4 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 100,000 و115,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 72,000 و76,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 2.5 لتر هجين (219 حصان بإجمالي قوة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات أو e-CVT (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Rav 4 على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على هوندا Cr-V التي تحافظ بنحو 49%، لكنها أقل من هيونداي كريتا التي تحافظ بنحو 60%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 186 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 14.6% — أعلى قليلاً من مازدا CX-5 (12.6%)، لا أعطال تكييف مسجلة. مقارنةً بـنيسان (1.2%). مقارنةً بـهيونداي (13.6%). نسبة تآكل الجنوط 3.4% — منخفضة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هوندا، نيسان، مازدا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ac:Tcd2,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا Rav 4 هي كروس أوفر مدمجة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 2.5 لتر هجين (219 حصان بإجمالي قوة)، مع ناقل حركة أوتوماتيكي من 8 سرعات أو e-CVT (هجين). تتراوح أسعار سيارات تويوتا Rav 4 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 100,000 و115,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 72,000 و76,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (203 حصان) أو سعة 2.5 لتر هجين (219 حصان بإجمالي قوة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات أو e-CVT (هجين)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185-195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا Rav 4 على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على هوندا Cr-V التي تحافظ بنحو 49%، لكنها أقل من هيونداي كريتا التي تحافظ بنحو 60%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 186 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 14.6% — أعلى قليلاً من مازدا CX-5 (12.6%)، لا أعطال تكييف مسجلة. مقارنةً بـنيسان (1.2%). مقارنةً بـهيونداي (13.6%). نسبة تآكل الجنوط 3.4% — منخفضة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هوندا، نيسان، مازدا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ad:Ta12,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RC350 هي كوبيه فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين أداء محرك V6 بتنفس طبيعي وتصميم لكزس المميز. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (306 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لكزس RC350 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و370,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 115,000 و290,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (306 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RC350 على نحو 44% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي A5 التي تحافظ بنحو 35%، لكنها أقل من مرسيدس-بنز CLS350 التي تحافظ بنحو 52%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ae:Ta12,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RC350 هي كوبيه فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين أداء محرك V6 بتنفس طبيعي وتصميم لكزس المميز. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (306 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لكزس RC350 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و370,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 115,000 و290,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (306 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RC350 على نحو 44% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي A5 التي تحافظ بنحو 35%، لكنها أقل من مرسيدس-بنز CLS350 التي تحافظ بنحو 52%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8af:Ta67,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا ريو هي سيدان صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (120 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات كيا ريو المستعملة في السعودية عادةً بين 20,000 و40,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (120 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية (1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165-180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 87 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 36.4% — أقل من هيونداي (3.8%). نسبة البقع الداخلية 21.4% — أقل من هيونداي (3.8%). نسبة أعطال التكييف 4.7%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هيونداي، تويوتا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b0:Ta67,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا ريو هي سيدان صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (120 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات كيا ريو المستعملة في السعودية عادةً بين 20,000 و40,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان) أو سعة 1.6 لتر بسحب طبيعي رباعي الأسطوانات (120 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية (1.4L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165-180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 87 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 36.4% — أقل من هيونداي (3.8%). نسبة البقع الداخلية 21.4% — أقل من هيونداي (3.8%). نسبة أعطال التكييف 4.7%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى هيونداي، تويوتا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b1:T955,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Rogue هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (181 حصان)، مع ناقل حركة أوتوماتيكي متغير باستمرار (CVT). تتراوح أسعار سيارات نيسان Rogue المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (181 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان Rogue على نحو 57% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 55%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b2:T955,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Rogue هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (181 حصان)، مع ناقل حركة أوتوماتيكي متغير باستمرار (CVT). تتراوح أسعار سيارات نيسان Rogue المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (181 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان Rogue على نحو 57% من قيمتها الأصلية بعد 5 سنوات، كما تتفوق على متوسط العلامة البالغ 55%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b3:Tba7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي RS3 هي سيارة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً مدمجاً عالي القوة مع طابع رياضي مميز. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي RS3 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 200,000 و350,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 85,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، يختلف بحسب الطراز)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (2.0T) إلى حوالي 5.0 ثانية (3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س بحسب الطراز\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تتوفر بتشكيلة واسعة من الطرازات التي تناسب احتياجات شرائح متعددة من المشترين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. يتطلب المحرك وقوداً ممتازاً والتزاماً دقيقاً بمواعيد تغيير الزيت للحفاظ على الاعتمادية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي RS3 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بي إم دبليو الفئة 1 التي تحافظ بنحو 45%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وفولكس واجن جولف GTI عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b4:Tba7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي RS3 هي سيارة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً مدمجاً عالي القوة مع طابع رياضي مميز. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي RS3 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 200,000 و350,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 85,000 و190,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، يختلف بحسب الطراز)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (2.0T) إلى حوالي 5.0 ثانية (3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س بحسب الطراز\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تتوفر بتشكيلة واسعة من الطرازات التي تناسب احتياجات شرائح متعددة من المشترين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. يتطلب المحرك وقوداً ممتازاً والتزاماً دقيقاً بمواعيد تغيير الزيت للحفاظ على الاعتمادية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي RS3 على نحو 43% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من بي إم دبليو الفئة 1 التي تحافظ بنحو 45%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وفولكس واجن جولف GTI عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b5:Tbe5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا راش هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر بسحب طبيعي رباعي الأسطوانات (104 حصان)، مع ناقل حركة أوتوماتيكي من 4 سرعات أو يدوي من 5 سرعات. تتراوح أسعار سيارات تويوتا راش المستعملة في السعودية عادةً بين 50,000 و65,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر بسحب طبيعي رباعي الأسطوانات (104 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 4 سرعات أو يدوي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 13.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث. قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا راش على نحو 68% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا فيلوز التي تحافظ بنحو 64%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 70 فحصاً أجرتها كارسويتش لسيارة Toyota Rush في السعودية، نسبة أضرار الهيكل الخارجي 7.6%، نسبة ملاحظات المقصورة الداخلية 10.1% (جيدة)، نسبة تلف الجنوط 7.4%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى ميتسوبيشي إكسباندر، سوزوكي Ertiga، وتويوتا فيلوز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b6:Tbe5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا راش هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر بسحب طبيعي رباعي الأسطوانات (104 حصان)، مع ناقل حركة أوتوماتيكي من 4 سرعات أو يدوي من 5 سرعات. تتراوح أسعار سيارات تويوتا راش المستعملة في السعودية عادةً بين 50,000 و65,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر بسحب طبيعي رباعي الأسطوانات (104 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 4 سرعات أو يدوي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 13.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث. قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا راش على نحو 68% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على تويوتا فيلوز التي تحافظ بنحو 64%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 70 فحصاً أجرتها كارسويتش لسيارة Toyota Rush في السعودية، نسبة أضرار الهيكل الخارجي 7.6%، نسبة ملاحظات المقصورة الداخلية 10.1% (جيدة)، نسبة تلف الجنوط 7.4%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى ميتسوبيشي إكسباندر، سوزوكي Ertiga، وتويوتا فيلوز عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b7:T8a5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإكسيد RX هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتطمح إلى تقديم إحساس قريب من السيارات الفاخرة داخل المقصورة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (254 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات إكسيد RX المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 140,000 و196,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (254 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إكسيد RX على حوالي 58% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من لكزس RX (53%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس RX، بي إم دبليو X5، ومرسيدس-بنز GLE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b8:T8a5,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإكسيد RX هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتطمح إلى تقديم إحساس قريب من السيارات الفاخرة داخل المقصورة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (254 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات إكسيد RX المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 140,000 و196,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (254 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إكسيد RX على حوالي 58% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من لكزس RX (53%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس RX، بي إم دبليو X5، ومرسيدس-بنز GLE عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8b9:Ta4c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX350 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بإقبال قوي بفضل اعتماديّتها ومنظومة محرك V6 السلسة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لكزس RX350 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 230,000 و250,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 145,000 و165,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.1 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 78 فحصاً لسيارة RX350 في السعودية. نسبة أضرار الهيكل الخارجي 11.2% ونسبة البقع الداخلية 6.4% فقط وهي نسبة استثنائية. لا أعطال تكييف مسجلة. معدل ملاك السيارة من أول مالك 29.5%، أعلى من المتوسط في فئة الفاخرة بالسعودية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8ba:Ta4c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX350 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بإقبال قوي بفضل اعتماديّتها ومنظومة محرك V6 السلسة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات لكزس RX350 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 230,000 و250,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 145,000 و165,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (295 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.1 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 78 فحصاً لسيارة RX350 في السعودية. نسبة أضرار الهيكل الخارجي 11.2% ونسبة البقع الداخلية 6.4% فقط وهي نسبة استثنائية. لا أعطال تكييف مسجلة. معدل ملاك السيارة من أول مالك 29.5%، أعلى من المتوسط في فئة الفاخرة بالسعودية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8bb:T84b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX350H هي سيارة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات مع المحرك الكهربائي الهجين (بإجمالي قوة 246 حصان)، مع ناقل حركة e-CVT. تتراوح أسعار سيارات لكزس RX350H المستعملة في السعودية عادةً بين 230,000 و280,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات مع المحرك الكهربائي الهجين (بإجمالي قوة 246 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e e-CVT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RX350H على نحو 58% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي Q7 التي تحافظ بنحو 39%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8bc:T84b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX350H هي سيارة هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات مع المحرك الكهربائي الهجين (بإجمالي قوة 246 حصان)، مع ناقل حركة e-CVT. تتراوح أسعار سيارات لكزس RX350H المستعملة في السعودية عادةً بين 230,000 و280,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات مع المحرك الكهربائي الهجين (بإجمالي قوة 246 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e e-CVT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RX350H على نحو 58% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي Q7 التي تحافظ بنحو 39%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8bd:Tac3,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX450h هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 بمحركات أمامية وخلفية وrear محركات كهربائية (313 حصان بإجمالي قوة)، مع ناقل حركة e-CVT (electrically منضبطة CVT). تتراوح أسعار سيارات لكزس RX450h المستعملة في السعودية عادةً بين 100,000 و170,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 بمحركات أمامية وخلفية وrear محركات كهربائية (313 حصان بإجمالي قوة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RX450h على نحو 51% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي Q7 التي تحافظ بنحو 39%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 21 فحصاً أجرتها كارسويتش لسيارة Lexus RX450h في السعودية، نسبة أضرار الهيكل الخارجي 9.7%، نسبة ملاحظات المقصورة الداخلية 14.3% (جيدة)، نسبة تلف الجنوط 28.6%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8be:Tac3,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس RX450h هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم هجينة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 بمحركات أمامية وخلفية وrear محركات كهربائية (313 حصان بإجمالي قوة)، مع ناقل حركة e-CVT (electrically منضبطة CVT). تتراوح أسعار سيارات لكزس RX450h المستعملة في السعودية عادةً بين 100,000 و170,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 بمحركات أمامية وخلفية وrear محركات كهربائية (313 حصان بإجمالي قوة)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ لكزس RX450h على نحو 51% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على أودي Q7 التي تحافظ بنحو 39%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 21 فحصاً أجرتها كارسويتش لسيارة Lexus RX450h في السعودية، نسبة أضرار الهيكل الخارجي 9.7%، نسبة ملاحظات المقصورة الداخلية 14.3% (جيدة)، نسبة تلف الجنوط 28.6%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، مرسيدس-بنز GLE، وأودي Q7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8bf:Ta88,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإم جي RX5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (163 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات إم جي RX5 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 70,000 و80,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و70,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (163 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إم جي RX5 على حوالي 39% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط إم جي البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات MG RX5 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 9.1%. نسبة تآكل الجنوط 9.0%. نسبة أضرار الهيكل الخارجي 10.8%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8c0:Ta88,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإم جي RX5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (163 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات إم