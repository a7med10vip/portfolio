003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية (xDrive)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو 750 على حوالي 27% من قيمتها الأصلية بعد مرور 5 سنوات. — أقل من أودي A7 (41%) ولكزس LS460 (63%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى مرسيدس-بنز، أودي، لكزس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5f0:T8a3,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو 750 هي سيارة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 4.4 لتر TwinPower Turbo V8 (449-530 حصان بحسب في الجيل)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو 750 المستعملة في السعودية عادةً بين 65,000 و120,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.4 لتر TwinPower Turbo V8 (449-530 حصان بحسب في الجيل)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية (xDrive)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي. قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو 750 على حوالي 27% من قيمتها الأصلية بعد مرور 5 سنوات. — أقل من أودي A7 (41%) ولكزس LS460 (63%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى مرسيدس-بنز، أودي، لكزس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5f1:T9d6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو 840 هي كوبيه فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين مساحة 5 Series وأكثر تصاميم بي إم دبليو الخارجية جرأة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي B58 (340 حصان)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو 840 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و235,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي B58 (340 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو 840 على نحو 59% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على مرسيدس-بنز CLS350 التي تحافظ بنحو 52%، كما تتفوق على متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى مرسيدس-بنز الفئة S كوبيه، بورش Panamera، وأودي A7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5f2:T9d6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو 840 هي كوبيه فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين مساحة 5 Series وأكثر تصاميم بي إم دبليو الخارجية جرأة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي B58 (340 حصان)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو 840 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما