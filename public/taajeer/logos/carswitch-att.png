u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فورد موستانج، شيفروليه كامارو، ودودج تشارجر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"677:Ta75,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدودج تشارجر هي سيدان كبيرة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر بنتاستار V6 (292 حصان)، سعة 5.7 لتر HEMI V8 (370 حصان)، أو سعة 6.4 لتر 392 HEMI (485 حصان)، مع ناقل حركة من 8 سرعات TorqueFlite أوتوماتيكي. تتراوح أسعار سيارات دودج تشارجر المستعملة في السعودية عادةً بين 30,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر بنتاستار V6 (292 حصان)، سعة 5.7 لتر HEMI V8 (370 حصان)، أو سعة 6.4 لتر 392 HEMI (485 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات TorqueFlite أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع، 5.7L HEMI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية (5.7L HEMI) إلى حوالي 4.3 ثانية (6.4L Scat Pack)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-278 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Charger على حوالي 32% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من Ford موستانج (37%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 166 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 25.1% — أقل من فورد (20.1%). نسبة أعطال التكييف 1.8% — منخفضة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى كرايسلر، شيفروليه، دودج عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"678:Ta75,"])</script><script>self.__next_f.push([1,"\u003cp\u003eدودج تشارجر هي سيدان كبيرة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.6 لتر بنتاستار V6 (292 حصان)، سعة 5.7 لتر HEMI V8 (370 حصان)، أو سعة 6.4 لتر 392 HEMI (485 حصان)، مع ناقل حركة من 8 سرعات TorqueFlite أوتوماتيكي. تتراوح أسعار سيارات دودج تشارجر المستعملة في السعودية عادةً بين 30,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.6 لتر بنتاستار V6 (292 حصان)، سعة 5.7 لتر HEMI V8 (370 حصان)، أو سعة 6.4 لتر 392 HEMI (485 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات TorqueFlite أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع، 5.7L HEMI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية (5.7L HEMI) إلى حوالي 4.3 ثانية (6.4L Scat Pack)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-278 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e استهلاك الوقود وتكاليف التشغيل قد يكونان مرتفعين في بعض الفئات.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ دودج Charger على حوالي 32% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من Ford موستانج (37%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 166 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 25.1% — أقل من فورد (20.1%). نسبة أعطال التكييف 1.8% — منخفضة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى كرايسلر، شيفروليه، دودج عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"679:T9e4,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيب Cherokee هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (270 حصان) أو سعة 3.2 لتر بنتاستار V6 (271 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات جيب Cherokee المستعملة في السعودية عادةً بين 20,000 و55,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (270 حصان) أو سعة 3.2 لتر بنتاستار V6 (271 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (V6 Trailhawk)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195-200 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جيب Cherokee على حوالي 48% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من فورد (43%) وأقل من نيسان (54%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Jeep Cherokee التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 17.4%. نسبة أعطال التكييف 6.5%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، ونيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"67a:T9e4,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجيب Cherokee هي سيارة رياضية متعددة الاستخدامات مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (270 حصان) أو سعة 3.2 لتر بنتاستار V6 (271 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات جيب Cherokee المستعملة في السعودية عادةً ب