افظ بنحو 41%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"769:Tbc7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز GLE400 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين محرك V6 ثنائي التيربو وخيار حقيقي لثلاثة صفوف من المقاعد. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (333 حصان)، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز GLE400 المستعملة في السعودية عادةً بين 95,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (333 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز GLE400 على نحو 49% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X4 التي تحافظ بنحو 36%، لكنها أقل من أودي SQ5 التي تحافظ بنحو 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 20 فحصاً أجرتها كارسويتش لسيارة Mercedes GLE400 في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 11.6% (جيدة)، نسبة تلف الجنوط 25.0%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"76a:Tbc7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز GLE400 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين محرك V6 ثنائي التيربو وخيار حقيقي لثلاثة صفوف من المقاعد. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (333 حصان)، مع ناقل حركة من 9 سرعات 9G-Tronic أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز GLE400 المستعملة في السعودية عادةً بين 95,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (333 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات 9G-Tronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز GLE400 على نحو 49% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على بي إم دبليو X4 التي تحافظ بنحو 36%، لكنها أقل من أودي SQ5 التي تحافظ بنحو 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 20 فحصاً أجرتها كارسويتش لسيارة Mercedes GLE400 في السعودية، لا توجد أعطال مسجلة في نظام التكييف — وهو أداء استثنائي، نسبة أضرار الهيكل الخارجي 11.6% (جيدة)، نسبة تلف الجنوط 25.0%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"76b:Tace,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز GLE43 AMG هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر AMG تيربو مزدوج V6 (390 حصان)، مع ناقل حركة من 9 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز GLE43 AMG المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و280,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر AMG تيربو مزدوج V6 (390 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.3 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X5، أودي Q7، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Mercedes GLE43 AMG التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 4.2%. نسبة تآكل الجنوط 4.3%. نسبة أضرار الهيكل الخارجي 6.7%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"76c:Tace,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز GLE43