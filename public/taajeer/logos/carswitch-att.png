\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، تويوتا، ميتسوبيشي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"873:Taee,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باترول هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر بسحب طبيعي V6 (275 حصان) أو سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات. تتراوح أسعار سيارات نيسان باترول المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 240,000 و330,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 140,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر بسحب طبيعي V6 (275 حصان) أو سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.5 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 232 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 10.5%. نسبة أعطال التكييف 4.3% — أقل من لاند كروزر في السعودية (5.0%). نسبة تآكل الجنوط 3.1% — منخفضة جداً. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، لكزس، جي إم سي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"874:Taee,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باترول هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر بسحب طبيعي V6 (275 حصان) أو سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات. تتراوح أسعار سيارات نيسان باترول المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 240,000 و330,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 140,000 و210,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر بسحب طبيعي V6 (275 حصان) أو سعة 5.6 لتر بسحب طبيعي V8 (400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 15.5 لتر/100 كم (استهلاك مجمع، V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 232 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 10.5%. نسبة أعطال التكييف 4.3% — أقل من لاند كروزر في السعودية (5.0%). نسبة تآكل الجنوط 3.1% — منخفضة جداً. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، لكزس، جي إم سي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"875:T90c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باترول Safari هي سيارة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 4.8 لتر بسحب طبيعي سداسي الأسطوانات خطي (250 حصان) أو سعة 4.2 لتر ديزل تيربو، مع ناقل حركة يدوي من 5 سرعات أو من 4 سرعات أوتوماتيكي. تتراوح أسعار سيارات نيسان باترول Safari المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.8 لتر بسحب طبيعي سداسي الأسطوانات خطي (250 حصان) أو سعة 4.2 لتر ديزل تيربو\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 5 سرعات أو من 4 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 170 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق. قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا لاند كروزر، نيسان باترول، وتويوتا برادو عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"876:T90c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان باترول Safari هي سيارة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 4.8 لتر بسحب طبيعي سداسي الأسطوانات خطي (250 حصان) أو سعة 4.2 لتر ديزل تيربو، مع ناقل حركة يدوي من 5 سرعات أو من 4 سرعات أوتوماتيكي. تتراوح أسعار سيارات نيسان باترول Safari المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.8 لتر بسحب طبيعي سداسي الأسطوانات خطي (250 حصان) أو سعة 4.2 لتر ديزل تيربو\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 5 سرعات أو من 4 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 14.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 170 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق. قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا لاند كروزر، نيسان باترول، وتويوتا برادو عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"877:Tac9,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا بيجاس هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 5 سرعات. تتراوح أسعار سيارات كيا بيجاس المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 40,000 و45,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 25,000 و75,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا بيجاس على نحو 54% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 59 فحصاً لسيارة Kia بيجاس في السعودية. نسبة أضرار الهيكل الخارجي 18.4% ونسبة البقع الداخلية 15.5%. نسبة أعطال التكييف 1.7% (منخفضة جداً). مقارنةً بـهيونداي Accent (27.6% هيكل، 18.2% داخل) و نيسان Sunny (27.1% هيكل، 19.4% داخل)، تصل هذه السيارة بحالة أفضل أو مماثلة في الهيكل الخارجي.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"878:Tac9,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا بيجاس هي سيدان مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 5 سرعات. تتراوح أسعار سيارات كيا بيجاس المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 40,000 و45,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 25,000 و75,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.4 لتر بسحب طبيعي رباعي الأسطوانات (100 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 5 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 165 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا بيجاس على نحو 54% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 59 فحصاً لسيارة Kia بيجاس في السعودية. نسبة أضرار الهيكل الخارجي 18.4% ونسبة البقع الداخلية 15.5%. نسبة أعطال التكييف 1.7% (منخفضة جداً). مقارنةً بـهيونداي Accent (27.6% هيكل، 18.2% داخل) و نيسان Sunny (27.1% هيكل، 19.4% داخل)، تصل هذه السيارة بحالة أفضل أو مماثلة في الهيكل الخارجي.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"879:T911,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا بيكانتو هي هاتشباك مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.0 لتر بسحب طبيعي ثلاثي الأسطوانات (67 حصان) أو سعة 1.2 لتر بسحب طبيعي رباعي الأسطوانات (84 حصان)، مع ناقل حركة أوتوماتيكي من 4 سرعات أو من 5 سرعات AMT. تتراوح أسعار سيارات كيا بيكانتو المستعملة في السعودية عادةً بين 16,000 و25,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.0 لتر بسحب طبيعي ثلاثي الأسطوانات (67 حصان) أو سعة 1.2 لتر بسحب طبيعي رباعي الأسطوانات (84 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 4 سرعات أو من 5 سرعات AMT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع، 1.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 14.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 150 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e المساحة الداخلية أو مساحة المقاعد الخلفية قد تكون أقل من بعض المنافسين. قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا بيكانتو على نحو 55% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"87a:T911,"])</script><script>self.__next_f.push([1,"\u003cp\u003eكيا بيكانتو هي هاتشباك مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.0 لتر بسحب طبيعي ثلاثي الأسطوانات (67 حصان) أو سعة 1.2 لتر بسحب طبيعي رباعي الأسطوانات (84 حصان)، مع ناقل حركة أوتوماتيكي من 4 سرعات أو من 5 سرعات AMT. تتراوح أسعار سيارات كيا بيكانتو المستعملة في السعودية عادةً بين 16,000 و25,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.0 لتر بسحب طبيعي ثلاثي الأسطوانات (67 حصان) أو سعة 1.2 لتر بسحب طبيعي رباعي الأسطوانات (84 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 4 سرعات أو من 5 سرعات AMT\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 5.5 لتر/100 كم (استهلاك مجمع، 1.0L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 14.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 150 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e المساحة الداخلية أو مساحة المقاعد الخلفية قد تكون أقل من بعض المنافسين. قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ كيا بيكانتو على نحو 55% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا يارس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا يارس، نيسان صني، وهيونداي أكسنت عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"87b:T9f9,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهوندا Pilot هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (280 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات هوندا Pilot المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 205,000 و240,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (280 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 29 فحصاً أجرتها كارسويتش لسيارة Honda Pilot في السعودية، نسبة أضرار الهيكل الخارجي 23.5% (جيدة)، نسبة تلف الجنوط 20.7%، نسبة أعطال التكييف 3.4% (تستحق الفحص الدقيق) — يستحق الفحص الدقيق.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، نيسان باثفايندر، وهيونداي سانتافي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"87c:T9f9,"])</script><script>self.__next_f.push([1,"\u003cp\u003eهوندا Pilot هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية. وتتوفر عادةً بخيارات محرك تشمل سعة 3.5 لتر بسحب طبيعي V6 (280 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات هوندا Pilot المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 205,000 و240,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.5 لتر بسحب طبيعي V6 (280 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. تقدم قيمة جيدة مقابل السعر وتكلفة شراء تنافسية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون استهلاك الوقود مرتفعاً، خصوصاً في الاستخدام اليومي.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 29 فحصاً أجرتها كارسويتش لسيارة Honda Pilot في السعودية، نسبة أضرار الهيكل الخارجي 23.5% (جيدة)، نسبة تلف الجنوط 20.7%، نسبة أعطال التكييف 3.4% (تستحق الفحص الدقيق) — يستحق الفحص الدقيق.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا برادو، نيسان باثفايندر، وهيونداي سانتافي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"87d:Tccf,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا برادو هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.7 لتر بسحب طبيعي رباعي الأسطوانات (163 حصان) أو سعة 2.8 لتر ديزل تيربو رباعي الأسطوانات (204 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات تويوتا برادو المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و235,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 130,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.7 لتر بسحب طبيعي رباعي الأسطوانات (163 حصان) أو سعة 2.8 لتر ديزل تيربو رباعي الأسطوانات (204 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 12.5 لتر/100 كم (استهلاك مجمع، 2.7L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 12.0 ثانية (2.7L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ تويوتا برادو على نحو 62% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على لكزس LX570 التي تحافظ بنحو 56%، لكنها أقل من لكزس LX600 التي تحافظ بنحو 69%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 126 فحصاً أجرتها كارسويتش لسيارة Toyota Prado في السعودية، نسبة أضرار الهيكل الخارجي 9.6%، نسبة ملاحظات المقصورة الداخلية 9.0% (ممتازة)، نسبة تلف الجنوط 1.7%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا فورتشنر، ميتسوبيشي باجيرو، ونيسان باثفايندر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"87e:Tccf,"])</script><script>self.__next_f.push([1,"\u003cp\u003eتويوتا برادو هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالاعتمادية والقيمة مقابل السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 2.7 لتر بسحب طبيعي رباعي الأسطوانات (163 حصان) أو سعة 2.8 لتر ديزل تيربو رباعي الأسطوانات (204 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات تويوتا برادو المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 180,000 و235,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 130,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cst