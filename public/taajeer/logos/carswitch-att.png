الداخلية 9.5%. نسبة أعطال التكييف 1.2% — منخفضة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"98b:T87b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eسوبارو WRX هي سيدان عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو Boxer رباعي الأسطوانات (268 حصان، الجيل الأقدم) أو سعة 2.4 لتر تيربو Boxer (271 حصان، الجيل الحالي)، مع ناقل حركة يدوي من 6 سرعات أو CVT (Lineartronic).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو Boxer رباعي الأسطوانات (268 حصان، الجيل الأقدم) أو سعة 2.4 لتر تيربو Boxer (271 حصان، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو CVT (Lineartronic)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (CVT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سوبارو WRX على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هوندا Civic Type R (54%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فولكس واجن جولف GTI، هوندا سيفيك تايب R، وبي إم دبليو الفئة 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"98c:T87b,"])</script><script>self.__next_f.push([1,"\u003cp\u003eسوبارو WRX هي سيدان عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو Boxer رباعي الأسطوانات (268 حصان، الجيل الأقدم) أو سعة 2.4 لتر تيربو Boxer (271 حصان، الجيل الحالي)، مع ناقل حركة يدوي من 6 سرعات أو CVT (Lineartronic).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو Boxer رباعي الأسطوانات (268 حصان، الجيل الأقدم) أو سعة 2.4 لتر تيربو Boxer (271 حصان، الجيل الحالي)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e يدوي من 6 سرعات أو CVT (Lineartronic)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع، 2.4T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (CVT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ سوبارو WRX على حوالي 45% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من هوندا Civic Type R (54%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى فولكس واجن جولف GTI، هوندا سيفيك تايب R، وبي إم دبليو الفئة 2 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"98d:Tc41,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان إكس-تريل هي كروس أوفر متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (144 حصان) أو سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (171 حصان)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان إكس-تريل المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 و120,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و160,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (144 حصان) أو سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (171 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان إكس-تريل على حوالي 50% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من هوندا Cr-V (49%) وأقل من هيونداي Kona (59%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 170 سيارة فحصتها كارسويتش في السعودية، مقارنةً بـ راف 4 (14.6%) وتوسان (13.6%). نسبة أعطال التكييف 1.2% (منخفضة). مقارنةً بتويوتا راف 4 (14.6% هيكل، 3.4% جنوط) وهيونداي توسان في نفس الفئة. مقارنةً بتويوتا راف 4 (14.6% هيكل، 3.4% جنوط) وهيونداي توسان (13.6% هيكل، 6.2% تكييف) في نفس الفئة.نسبة أضرار الهيكل الخارجي 8.1%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 13.5%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، مازدا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"98e:Tc41,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان إكس-تريل هي كروس أوفر متوسطة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (144 حصان) أو سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (171 حصان)، مع ناقل حركة CVT (Xtronic) أوتوماتيكي. تتراوح أسعار سيارات نيسان إكس-تريل المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 85,000 و120,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و160,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر بسحب طبيعي رباعي الأسطوانات (144 حصان) أو سعة 2.5 لتر بسحب طبيعي رباعي الأسطوانات (171 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT (Xtronic) أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية (2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 185 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ نيسان إكس-تريل على حوالي 50% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من هوندا Cr-V (49%) وأقل من هيونداي Kona (59%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 170 سيارة فحصتها كارسويتش في السعودية، مقارنةً بـ راف 4 (14.6%) وتوسان (13.6%). نسبة أعطال التكييف 1.2% (منخفضة). مقارنةً بتويوتا راف 4 (14.6% هيكل، 3.4% جنوط) وهيونداي توسان في نفس الفئة. مقارنةً بتويوتا راف 4 (14.6% هيكل، 3.4% جنوط) وهيونداي توسان (13.6% هيكل، 6.2% تكييف) في نفس الفئة.نسبة أضرار الهيكل الخارجي 8.1%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 13.5%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، مازدا عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"98f:Tc7f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X1 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتوفر مدخلاً عملياً إلى فئة سيارات بي إم دبليو الفاخرة، مع جودة مقصورة مميزة بأسعار مستعملة مناسبة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات، مع ناقل حركة من 7 سرعات DCT مزدوج القابض أو من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X1 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 150,000 و175,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT مزدوج القابض أو من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (1.5T) إلى حوالي 7.0 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X1 على نحو 37% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من إنفينيتي QX30 التي تحافظ بنحو 34%، كما تقل عن متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 33 فحصاً أجرتها كارسويتش لسيارة BMW X1 في السعودية، نسبة أضرار الهيكل الخارجي 7.7%، نسبة ملاحظات المقصورة الداخلية 6.7% (ممتازة)، نسبة تلف الجنوط 10.0%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q3، مرسيدس-بنز GLA، ولكزس UX عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"990:Tc7f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X1 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتوفر مدخلاً عملياً إلى فئة سيارات بي إم دبليو الفاخرة، مع جودة مقصورة مميزة بأسعار مستعملة مناسبة. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات، مع ناقل حركة من 7 سرعات DCT مزدوج القابض أو من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X1 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 150,000 و175,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT مزدوج القابض أو من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 1.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.5 ثانية (1.5T) إلى حوالي 7.0 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X1 على نحو 37% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من إنفينيتي QX30 التي تحافظ بنحو 34%، كما تقل عن متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eاستناداً إلى 33 فحصاً أجرتها كارسويتش لسيارة BMW X1 في السعودية، نسبة أضرار الهيكل الخارجي 7.7%، نسبة ملاحظات المقصورة الداخلية 6.7% (ممتازة)، نسبة تلف الجنوط 10.0%.\u003c/p\u003e\n\u003cp\u003eيُنصح دائماً بمراجعة تقرير فحص كارسويتش وسجل الصيانة لكل سيارة للتأكد من حالتها الفعلية.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q3، مرسيدس-بنز GLA، ولكزس UX عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"991:Ta0f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X2 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم تصميماً أكثر جرأة وطابعاً رياضياً مقارنةً بـ X1. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات، مع ناقل حركة من 7 سرعات DCT مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X2 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 215,000 و240,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و80,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية (xDrive20i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q3، مرسيدس-بنز GLA، ورينج روفر إيفوك عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات BMW X2 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"992:Ta0f,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X2 هي سيارة رياضية متعددة الاستخدامات مدمجة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم تصميماً أكثر جرأة وطابعاً رياضياً مقارنةً بـ X1. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات، مع ناقل حركة من 7 سرعات DCT مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X2 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 215,000 و240,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 65,000 و80,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر TwinPower Turbo ثلاثي الأسطوانات أو سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات DCT مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 6.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.7 ثانية (xDrive20i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q3، مرسيدس-بنز GLA، ورينج روفر إيفوك عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات BMW X2 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.4%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"993:Tc96,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X3 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بشعبية كبيرة بفضل ديناميكيات القيادة وجودة مقصورة بي إم دبليو. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X3 المستعملة في السعودية عادةً بين 125,000 و140,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (xDrive20i) إلى حوالي 4.8 ثانية (M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X3 على حوالي 38% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز GLC300 (26%) وأقل من إنفينيتي QX50 (41%) وأقل من متوسط بي إم دبليو البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q5، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات BMW X3 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 4.2%. نسبة تآكل الجنوط 13.0%. نسبة أضرار الهيكل الخارجي 8.2%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"994:Tc96,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X3 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بشعبية كبيرة بفضل ديناميكيات القيادة وجودة مقصورة بي إم دبليو. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X3 المستعملة في السعودية عادةً بين 125,000 و140,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (xDrive20i) إلى حوالي 4.8 ثانية (M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X3 على حوالي 38% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من مرسيدس-بنز GLC300 (26%) وأقل من إنفينيتي QX50 (41%) وأقل من متوسط بي إم دبليو البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q5، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات BMW X3 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 4.2%. نسبة تآكل الجنوط 13.0%. نسبة أضرار الهيكل الخارجي 8.2%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"995:T9b6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X3 M هي سيارة رياضية متعددة الاستخدامات عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي Competition (510 حصان)، مع ناقل حركة من 8 سرعات M Steptronic xDrive. تتراوح أسعار سيارات بي إم دبليو X3 M المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و235,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي Competition (510 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات M Steptronic xDrive\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً، 285 كم/س مع M Driver Package)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X3 M على حوالي 48% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من متوسط بي إم دبليو البالغ 43%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q5، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"996:T9b6,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X3 M هي سيارة رياضية متعددة الاستخدامات عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالأداء. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي Competition (510 حصان)، مع ناقل حركة من 8 سرعات M Steptronic xDrive. تتراوح أسعار سيارات بي إم دبليو X3 M المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و445,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 105,000 و235,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر S58 TwinPower Turbo سداسي الأسطوانات خطي Competition (510 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات M Steptronic xDrive\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 3.8 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250 كم/س (محدود إلكترونياً، 285 كم/س مع M Driver Package)\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X3 M على حوالي 48% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من متوسط بي إم دبليو البالغ 43%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى أودي Q5، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"997:Tb57,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X4 هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X4 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 245,000 و315,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 110,000 و155,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (xDrive20i) إلى حوالي 4.8 ثانية (M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات BMW X4 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 0.0% — أقل من very rarely (0.0%). نسبة تآكل الجنوط 10.5%. نسبة أضرار الهيكل الخارجي 9.2%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى مرسيدس-بنز، أودي، بورشه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"998:Tb57,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X4 هي سيارة رياضية متعددة الاستخدامات متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X4 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 245,000 و315,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 110,000 و155,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TwinPower Turbo رباعي الأسطوانات (184-252 حصان) أو سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (360 حصان، M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (xDrive20i) إلى حوالي 4.8 ثانية (M40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات BMW X4 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 0.0% — أقل من very rarely (0.0%). نسبة تآكل الجنوط 10.5%. نسبة أضرار الهيكل الخارجي 9.2%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى مرسيدس-بنز، أودي، بورشه عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"999:Ta5c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X5 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على الطرق الوعرة ومقصورة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (340-394 حصان) أو سعة 4.4 لتر TwinPower Turbo V8 (X5 M Competition)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X5 المستعملة في السعودية عادةً بين 75,000 و190,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (340-394 حصان) أو سعة 4.4 لتر TwinPower Turbo V8 (X5 M Competition)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Steptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، xDrive40i)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.5 ثانية (xDrive40i) إلى حوالي 3.8 ثانية (X5 M Competition)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 245-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي إم دبليو X5 على حوالي 38% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من لكزس RX350 (42%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 85 فحصاً لسيارة X5 في السعودية. نسبة أضرار الهيكل الخارجي 11.1% ونسبة البقع الداخلية 10.7%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى مرسيدس-بنز GLE، أودي Q7، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"99a:Ta5c,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي إم دبليو X5 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين قدرات حقيقية على الطرق الوعرة ومقصورة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (340-394 حصان) أو سعة 4.4 لتر TwinPower Turbo V8 (X5 M Competition)، مع ناقل حركة من 8 سرعات Steptronic أوتوماتيكي. تتراوح أسعار سيارات بي إم دبليو X5 المستعملة في السعودية عادةً بين 75,000 و190,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر TwinPower Turbo سداسي الأسطوانات خطي (340-394 حصان) أو سعة 4.4 لتر TwinPower Turbo V8 (X5 M Competition)\u003c/li\u003e\u003cli\u0