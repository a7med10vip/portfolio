strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 5، مرسيدس-بنز الفئة E، وجينيسيس G80 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e6c2:T7c8,\u003cp\u003eكاديلاك Cts هي سيدان "])</script><script>self.__next_f.push([1,"متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم قوة محرك V6 ومواد فاخرة بأسعار سيارات مستعملة مناسبة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6، مع ناقل حركة من 6 سرعات أو من 8 سرعات أوتوماتيكي. تتراوح أسعار سيارات كاديلاك Cts المستعملة بعمر خمس إلى ست سنوات في السعودية بين 95,000 و440,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.6 لتر بسحب طبيعي V6\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 6 سرعات أو من 8 سرعات أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.5 لتر/100 كم (استهلاك مجمع، 3.6L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (3.6L V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 240 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون جودة الركوب قاسية أو أقل راحة على بعض الطرق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 5، مرسيدس-بنز الفئة E، وجينيسيس G80 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e6c3:Ta7a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-3 هي كروس أوفر صغيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بجودة مقصورة تتجاوز فئتها السعرية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر SkyActiv-G سحب طبيعي رباعي الأسطوانات (155 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-3 المستعملة في السعودية عادةً بين 45,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر SkyActiv-G سحب طبيعي رباعي الأسطوانات (155 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-3 على حوالي 70% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا كورولا (64%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mazda CX-3 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 18.9%. نسبة البقع الداخلية 16.0%. نسبة أعطال التكييف 4.0%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c4:Ta7a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-3 هي كروس أوفر صغيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتتميز بجودة مقصورة تتجاوز فئتها السعرية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر SkyActiv-G سحب طبيعي رباعي الأسطوانات (155 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-3 المستعملة في السعودية عادةً بين 45,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر SkyActiv-G سحب طبيعي رباعي الأسطوانات (155 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات أو يدوي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-3 على حوالي 70% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا كورولا (64%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mazda CX-3 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 18.9%. نسبة البقع الداخلية 16.0%. نسبة أعطال التكييف 4.0%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c5:Tae7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-30 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم إحساساً قريباً من الفخامة في المقصورة بأسعار الفئة السائدة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر SkyActiv-G سحب طبيعي (191 حصان) أو سعة 2.5 لتر SkyActiv-G تيربو (227 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-30 المستعملة في السعودية عادةً بين 55,000 و85,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر SkyActiv-G سحب طبيعي (191 حصان) أو سعة 2.5 لتر SkyActiv-G تيربو (227 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L NA) إلى حوالي 6.5 ثانية (2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-30 على حوالي 68% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا RAV4 (56%) وأعلى من متوسط مازدا البالغ 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mazda CX-30 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 2.7%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 10.4%. نسبة الجنوط التالفة 5.7%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c6:Tae7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-30 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم إحساساً قريباً من الفخامة في المقصورة بأسعار الفئة السائدة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر SkyActiv-G سحب طبيعي (191 حصان) أو سعة 2.5 لتر SkyActiv-G تيربو (227 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-30 المستعملة في السعودية عادةً بين 55,000 و85,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.5 لتر SkyActiv-G سحب طبيعي (191 حصان) أو سعة 2.5 لتر SkyActiv-G تيربو (227 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L NA) إلى حوالي 6.5 ثانية (2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 200-210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-30 على حوالي 68% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من تويوتا RAV4 (56%) وأعلى من متوسط مازدا البالغ 51%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين سيارات Mazda CX-30 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 2.7%.\u003c/p\u003e\n\u003cp\u003eنسبة أضرار الهيكل الخارجي 10.4%. نسبة الجنوط التالفة 5.7%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c7:Tbf7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بتقدير كبير بفضل جودة مقصورتها الاستثنائية، ومحركاتها الموثوقة، وديناميكيات قيادتها الممتعة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر SkyActiv-G سحب طبيعي (165 حصان)، سعة 2.5 لتر بسحب طبيعي (192 حصان)، أو سعة 2.5 لتر تيربو (227-256 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-5 المستعملة بعمر خمس إلى ست سنوات في السعودية بين 65,000 و90,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر SkyActiv-G سحب طبيعي (165 حصان)، سعة 2.5 لتر بسحب طبيعي (192 حصان)، أو سعة 2.5 لتر تيربو (227-256 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L NA) إلى حوالي 6.5 ثانية (2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مازدا CX-5 على حوالي 53% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من نيسان إكس-تريل (50%) وأقل من تويوتا RAV4 (57%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 102 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 12.6% — أقل من تويوتا (14.6%) وهيونداي (13.6%). نسبة البقع الداخلية 6.9% — أقل من هيونداي (13.6%). لا أعطال تكييف مسجلة. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة. 14.6%. 13.6%. 0.9%.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6c8:Tbf7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمازدا CX-5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بتقدير كبير بفضل جودة مقصورتها الاستثنائية، ومحركاتها الموثوقة، وديناميكيات قيادتها الممتعة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر SkyActiv-G سحب طبيعي (165 حصان)، سعة 2.5 لتر بسحب طبيعي (192 حصان)، أو سعة 2.5 لتر تيربو (227-256 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات مازدا CX-5 المستعملة بعمر خمس إلى ست سنوات في السعودية بين 65,000 و90,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر SkyActiv-G سحب طبيعي (165 حصان)، سعة 2.5 لتر بسحب طبيعي (192 حصان)، أو سعة 2.5 لتر تيربو (227-256 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.5L)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية (2.5L NA) إلى حوالي 6.5 ثانية (2.5T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 205-215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cs