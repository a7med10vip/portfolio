03eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي Q70 على حوالي 34% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من بي إم دبليو 530 (39%) وأقل من متوسط إنفينيتي البالغ 50%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"88e:T889,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي Q70 هي سيدان كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم دفعاً خلفياً مع خيار محرك V6 سعة 3.7 لتر أو V8 سعة 5.6 لتر. وتتوفر عادةً بخيارات محرك تشمل سعة 3.7 لتر بسحب طبيعي V6 (329 حصان) أو سعة 5.6 لتر بسحب طبيعي V8، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.7 لتر بسحب طبيعي V6 (329 حصان) أو سعة 5.6 لتر بسحب طبيعي V8\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.5 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 235 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي Q70 على حوالي 34% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من بي إم دبليو 530 (39%) وأقل من متوسط إنفينيتي البالغ 50%.\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى لكزس ES، بي إم دبليو الفئة 5، ومرسيدس-بنز الفئة E عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"88f:Tbcc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q8 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم حضوراً رائداً يجمع بين فخامة سيارات الدفع الرباعي وتصميم الكوبيه. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر 55 TFSI هجين خفيف V6 (340 حصان) أو سعة 4.0 لتر RS Q8 تيربو مزدوج V8 (600 حصان)، مع ناقل حركة من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي Q8 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 295,000 و420,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 170,000 و215,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر 55 TFSI هجين خفيف V6 (340 حصان) أو سعة 4.0 لتر RS Q8 تيربو مزدوج V8 (600 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 11.0 لتر/100 كم (استهلاك مجمع، 55 TFSI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 5.9 ثانية لفئة 55 TFSI quattro إلى حوالي 3.8 ثانية لفئة RS Q8\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 250-305 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ أودي Q8 على حوالي 39% من قيمتها الأصلية بعد مرور 5 سنوات — أعلى من بي إم دبليو X6 (33%) وأقل من لكزس LX570 (56%).\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X6، مرسيدس-بنز GLE كوبيه، وبورش Cayenne عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Audi Q8 التي فحصتها كارسويتش في السعودية، نسبة البقع الداخلية 5.0%. نسبة تآكل الجنوط 15.8%. نسبة أضرار الهيكل الخارجي 8.9%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"890:Tbcc,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q8 هي سيارة رياضية متعددة الاستخدامات كبيرة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم حضوراً رائداً يجمع بين فخامة سيارات الدفع الرباعي وتصميم الكوبيه. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر 55 TFSI هجين خفيف V6 (340 حصان) أو سعة 4.0 لتر RS Q8 تيربو مزدوج V8 (600 حصان)، مع ناقل حركة من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي Q8 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 295,000 و420,000 ريال، بينما تتراوح أسعار السيارات بعمر 