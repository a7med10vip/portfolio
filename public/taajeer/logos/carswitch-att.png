ا أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"891:T876,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Qashqai هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو DiG-T رباعي الأسطوانات (140-158 حصان)، مع ناقل حركة CVT أو من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات نيسان Qashqai المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو DiG-T رباعي الأسطوانات (140-158 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"892:T876,"])</script><script>self.__next_f.push([1,"\u003cp\u003eنيسان Qashqai هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.3 لتر تيربو DiG-T رباعي الأسطوانات (140-158 حصان)، مع ناقل حركة CVT أو من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات نيسان Qashqai المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 55,000 و195,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 35,000 و150,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.3 لتر تيربو DiG-T رباعي الأسطوانات (140-158 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e CVT أو من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.0 لتر/100 كم (استهلاك مجمع، 1.3T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 9.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تتميز باستهلاك وقود اقتصادي يناسب الاستخدام اليومي. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يقلل ناقل الحركة المتغير باستمرار (CVT) من متعة القيادة لدى بعض المشترين. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا راف فور، هوندا Cr-V، ونيسان إكس-تريل عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"893:T966,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي Qin Plus هي سيدان مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو PHEV مع محرك كهربائي (218 حصان استهلاك مجمع) أو كهربائي بالكامل، مع ناقل حركة e-CVT أو ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو PHEV مع محرك كهربائي (218 حصان استهلاك مجمع) أو كهربائي بالكامل\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e e-CVT أو ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 1.4 لتر/100 كم (PHEV استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.3 ثانية (PHEV)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي واي دي Qin Plus على نحو 52% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على جي إيه سي Aion S التي تحافظ بنحو 51%، لكنها أقل من هيونداي إلنترا هايبرد التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا هايبرد، هيونداي إلنترا هايبرد، وجي إيه سي Aion S عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"894:T966,"])</script><script>self.__next_f.push([1,"\u003cp\u003eبي واي دي Qin Plus هي سيدان مدمجة كهربائية متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو PHEV مع محرك كهربائي (218 حصان استهلاك مجمع) أو كهربائي بالكامل، مع ناقل حركة e-CVT أو ناقل حركة أحادي السرعة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو PHEV مع محرك كهربائي (218 حصان استهلاك مجمع) أو كهربائي بالكامل\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e e-CVT أو ناقل حركة أحادي السرعة\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 1.4 لتر/100 كم (PHEV استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.3 ثانية (PHEV)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 180 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر تجربة قيادة كهربائية هادئة وتكاليف تشغيل أقل للاستخدام اليومي. توفر مجموعة جيدة من أنظمة السلامة ومساعدة السائق. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e لا تزال بنية الشحن التحتية قيد التطور في بعض المناطق. لا تزال قيمة إعادة البيع غير مستقرة أو غير مثبتة بشكل كافٍ في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ بي واي دي Qin Plus على نحو 52% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على جي إيه سي Aion S التي تحافظ بنحو 51%، لكنها أقل من هيونداي إلنترا هايبرد التي تحافظ بنحو 53%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا كورولا هايبرد، هيونداي إلنترا هايبرد، وجي إيه سي Aion S عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"895:T7f5,\u003cp\u003eمازيراتي Quattroporte هي سيارة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداء محرك V8 وحصرية سيارة سيدان إيطالية رائدة ونادرة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (523-580 حصان، Trofeo)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (523-580 حصان، Trofeo)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.7 ثانية (GTS V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 275-326 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض البدائل اليابانية أو الكورية أو الأكثر رسوخاً في السوق. قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش Panamera، مرسيدس-بنز الفئة S، وبي إم دبليو الفئة 7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e89"])</script><script>self.__next_f.push([1,"6:T7f5,\u003cp\u003eمازيراتي Quattroporte هي سيارة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداء محرك V8 وحصرية سيارة سيدان إيطالية رائدة ونادرة. وتتوفر عادةً بخيارات محرك تشمل سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (523-580 حصان، Trofeo)، مع ناقل حركة أوتوماتيكي من 8 سرعات من ZF.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 3.0 لتر تيربو مزدوج V6 (350-430 حصان) أو سعة 3.8 لتر تيربو مزدوج V8 (523-580 حصان، Trofeo)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات من ZF\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 13.5 لتر/100 كم (استهلاك مجمع، V6)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.7 ثانية (GTS V8)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 275-326 كم/س بحسب الفئة\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض البدائل اليابانية أو الكورية أو الأكثر رسوخاً في السوق. قد يكون توفر قطع الغيار أو شبكة الخدمة محدوداً في بعض المناطق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بورش Panamera، مرسيدس-بنز الفئة S، وبي إم دبليو الفئة 7 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e897:"])</script><script>self.__next_f.push([1,"T764,\u003cp\u003eإنفينيتي QX30 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتستفيد من هندسة مرسيدس-بنز ضمن سيارة كروس أوفر مدمجة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.3 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل. قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X1، أودي Q3، ومرسيدس-بنز GLA عند مقارنة الخيارات المتوفرة.\u003c/p\u003e898:T764,\u003cp\u003eإنفينيتي QX30 هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في الس"])</script><script>self.__next_f.push([1,"عودية. وتستفيد من هندسة مرسيدس-بنز ضمن سيارة كروس أوفر مدمجة فاخرة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/s