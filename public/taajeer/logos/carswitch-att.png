.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 215 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون المساحة في الصف الخلفي أو صندوق الأمتعة محدودة مقارنةً ببعض البدائل.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وأودي A3 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e885:Tb4d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بإقبال قوي بفضل توازن الأداء، وجودة المقصورة، وقدرات نظام quattro. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (190-252 حصان) أو سعة 3.0 لتر TFSI V6 (SQ5)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي Q5 المستعملة في السعودية عادةً بين 30,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (190-252 حصان) أو سعة 3.0 لتر TFSI V6 (SQ5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 5.1 ثانية (SQ5 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 222-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Audi Q5 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 15.0%. تقرير الفحص الفردي من كارسويتش هو أدق طريقة لتقييم الحالة الفعلية قبل الشراء.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eنقطة المراقبة:\u003c/strong\u003e أعطال التكييف عند 5.0% — من أعلى المعدلات في هذه الفئة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eتقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"886:Tb4d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي Q5 هي سيارة رياضية متعددة الاستخدامات متوسطة الحجم فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتحظى بإقبال قوي بفضل توازن الأداء، وجودة المقصورة، وقدرات نظام quattro. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (190-252 حصان) أو سعة 3.0 لتر TFSI V6 (SQ5)، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات أودي Q5 المستعملة في السعودية عادةً بين 30,000 و100,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر TFSI تيربو رباعي الأسطوانات (190-252 حصان) أو سعة 3.0 لتر TFSI V6 (SQ5)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T 190 حصان) إلى حوالي 5.1 ثانية (SQ5 3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 222-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eقد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو X3، مرسيدس-بنز GLC، وبورش Macan عند مقارنة الخيارات المتوفرة.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات Audi Q5 التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 15.0%. تقرير الفحص الفردي من كارسويتش هو أدق طريقة لتقييم الحالة الفعلية قبل الشراء.\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eنقطة المراقبة:\u003c/strong\u003e أعطال التكييف عند 5.0% — من أعلى المعدلات في هذه الفئة.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eتقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"887:T914,"])</script><script>self.__next_f.push([1,"\u003cp\u003eإنفينيتي Q50 هي سيدان فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتقدم أداءً قوياً من محرك V6 ثنائي التيربو بأسعار أقل من سيارات بي إم دبليو الفئة 3 المماثلة. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)، مع ناقل حركة أوتوماتيكي من 7 سرعات.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (211 حصان) أو سعة 3.0 لتر تيربو مزدوج V6 (300-400 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 7 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.2 ثانية (3.0T 400 حصان) إلى حوالي 8.0 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220-250 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يوفر المحرك أداءً مناسباً للقيادة داخل المدينة وعلى الطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e يُنصح بفحص سجل الصيانة والحالة الفنية بعناية قبل الشراء.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ إنفينيتي Q50 على نحو 44% من قيمتها الأصلية بعد 5 سنوات، متفوقةً على مرسيدس-بنز A200 التي تحافظ بنحو 35%، لكنها أقل من مرسيدس-بنز C300 التي تحافظ بنحو 50%، كما تقل عن متوسط العلامة البالغ 50%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self._