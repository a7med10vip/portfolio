 2.5 لتر بسحب طبيعي V6 (204 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 6 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 10.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 8.0 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. تتمتع باعتمادية جيدة وتكاليف صيانة طويلة الأجل يمكن التحكم بها عند الالتزام بالصيانة الدورية. تتميز بتصميم عصري يمنحها حضوراً واضحاً بين المنافسين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية. تبدو بعض التقنيات أو التجهيزات قديمة مقارنةً بالمنافسين الأحدث.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"7ce:T8e2,"])</script><script>self.__next_f.push([1,"\u003cp\u003eلكزس IS250 هي سيدان مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين أسعار سيارات مستعملة مناسبة ومحرك V6 سلس. وتتوفر عادةً بخيارات محرك تشمل سعة 2.5 لتر بسحب طبيعي V6 (204 حصان)، مع ناقل حركة أوتوماتيكي من 6 سرعات. تتراوح أسعار سيارات لكزس IS250 المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 185,000 و370,000 ريال، بينما تتراوح أسعار السيارات بعمر خمس إلى ست سنوات بين 115,000 و290,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003