ext_f.push([1,"\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى تويوتا هايلاندر، كيا سورينتو، وهيونداي سانتافي عند مقارنة الخيارات المتوفرة.\u003c/p\u003e8cb:Ta53,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي S3 هي سيارة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين مقصورة راقية، ونظام quattro للدفع الكلي، وأداء رياضي قوي. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي S3 المستعملة في السعودية عادةً بين 65,000 و70,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، يختلف بحسب الطراز)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (2.0T) إلى حوالي 5.0 ثانية (3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س بحسب الطراز\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تحافظ على قيمة إعادة بيع قوية مقارنةً بالعديد من المنافسين. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. تتوفر بتشكيلة واسعة من الطرازات التي تناسب احتياجات شرائح متعددة من المشترين.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان. يتطلب المحرك وقوداً ممتازاً والتزاماً دقيقاً بمواعيد تغيير الزيت للحفاظ على الاعتمادية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 1، مرسيدس-بنز الفئة A، وفولكس واجن جولف GTI عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"8cc:Ta53,"])</script><script>self.__next_f.push([1,"\u003cp\u003eأودي S3 هي سيارة فاخرة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين مقصورة راقية، ونظام quattro للدفع الكلي، وأداء رياضي قوي. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات، مع ناقل حركة من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي. تتراوح أسعار سيارات أودي S3 المستعملة في السعودية عادةً بين 65,000 و70,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات أو سعة 3.0 لتر تيربو V6 في معظم الطرازات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات S tronic مزدوج القابض أو من 8 سرعات Tiptronic أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.5 لتر/100 كم (استهلاك مجمع، يختلف بحسب الطراز)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.5 ثانية (2.0T) إلى حوالي 5.0 ثانية (3.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 210-250 كم/س بحسب الطراز\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تحافظ على قيمة إعادة ب