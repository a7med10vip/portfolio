i\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جي إم سي Terrain على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط جي إم سي البالغ 44%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات GMC Terrain التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.1%. نسبة أعطال التكييف 4.8%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"93c:Tb1a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجي إم سي تيرين هي كروس أوفر مدمجة فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتجمع بين أداء تيربو ومقصورة مجهزة بعناية. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات أو سعة 2.0 لتر تيربو رباعي الأسطوانات (252 حصان)، مع ناقل حركة أوتوماتيكي من 9 سرعات. تتراوح أسعار سيارات جي إم سي تيرين المستعملة في السعودية عادةً بين 30,000 و75,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات أو سعة 2.0 لتر تيربو رباعي الأسطوانات (252 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 9 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.5 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 7.5 ثانية (2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 195 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جي إم سي Terrain على حوالي 40% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من متوسط جي إم سي البالغ 44%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن سيارات GMC Terrain التي فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 16.1%. نسبة أعطال التكييف 4.8%. تقرير الفحص النظيف وسجل الصيانة الموثق هما أقوى معيارَين عند اتخاذ قرار الشراء.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، نيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"93d:Tb5d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد Territory هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر EcoBoost تيربو ثلاثي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات فورد Territory المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 90,000 و115,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر EcoBoost تيربو ثلاثي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Territory على نحو 54% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا Rav 4 التي تحافظ بنحو 14.6%، كما تتفوق على متوسط العلامة البالغ 37%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 131 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 5.2% — أقل من تويوتا (14.6%) وهيونداي (13.6%). نسبة البقع الداخلية 1.6% — أقل من تويوتا (14.6%) وهيونداي (13.6%). لا أعطال تكييف مسجلة. للمشترين الذين يقارنون فورد تيريتوري بالبدائل المتاحة، تدعم بيانات فحص كارسويتش هذا الخيار باستمرار.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، ونيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"93e:Tb5d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eفورد Territory هي كروس أوفر مدمجة متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر EcoBoost تيربو ثلاثي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات فورد Territory المستعملة بعمر سنة إلى سنتين في السعودية عادةً بين 90,000 و115,000 ريال.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر EcoBoost تيربو ثلاثي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 8.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام. توفر مقصورة رحبة وعملية مع مساحة جيدة للركاب والأمتعة. يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد يكون الأداء متواضعاً عند التحميل الكامل أو السرعات العالية.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ فورد Territory على نحو 54% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من تويوتا Rav 4 التي تحافظ بنحو 14.6%، كما تتفوق على متوسط العلامة البالغ 37%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eنتائج الفحص\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eمن بين 131 سيارة فحصتها كارسويتش في السعودية، نسبة أضرار الهيكل الخارجي 5.2% — أقل من تويوتا (14.6%) وهيونداي (13.6%). نسبة البقع الداخلية 1.6% — أقل من تويوتا (14.6%) وهيونداي (13.6%). لا أعطال تكييف مسجلة. للمشترين الذين يقارنون فورد تيريتوري بالبدائل المتاحة، تدعم بيانات فحص كارسويتش هذا الخيار باستمرار.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر كثير من المشترين أيضاً إلى تويوتا، هوندا، ونيسان عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"93f:T893,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيري Tiggo 4 Pro هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات شيري Tiggo 4 Pro المستعملة في السعودية عادةً بين 55,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم تجهيزات وتقنيات جيدة تعزز الراحة وسهولة الاستخدام.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ شيري Tiggo 4 Pro على نحو 60% من قيمتها الأصلية بعد 5 سنوات، لكنها أقل من نيسان كيكس التي تحافظ بنحو 63%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى نيسان كيكس، هيونداي كريتا، وكيا سيلتوس عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"940:T893,"])</script><script>self.__next_f.push([1,"\u003cp\u003eشيري Tiggo 4 Pro هي كروس أوفر صغيرة الحجم متوفرة في سوق السيارات المستعملة في السعودية. وتشتهر بالتصميم. وتتوفر عادةً بخيارات محرك تشمل سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)، مع ناقل حركة من 7 سرعات مزدوج القابض أوتوماتيكي. تتراوح أسعار سيارات شيري Tiggo 4 Pro المستعملة في السعودية عادةً بين 55,000 و60,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 1.5 لتر تيربو رباعي الأسطوانات (147 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 7 سرعات مزدوج القابض أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 7.5 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 10.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 175 كم/س\u003c/li\u003e\u003c/ul\u