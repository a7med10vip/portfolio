\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 18.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز G63 AMG على نحو 24% من قيمتها الأصلية بعد 5 سنوات، كما تقل عن متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى رينج روفر، لكزس LX، وتويوتا لاند كروزر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"744:T910,"])</script><script>self.__next_f.push([1,"\u003cp\u003eمرسيدس-بنز G63 AMG هي سيارة رياضية متعددة الاستخدامات فاخرة متوفرة في سوق السيارات المستعملة في السعودية. وتعد من أكثر سيارات الدفع الرباعي المستعملة هيبةً وارتفاعاً في السعر. وتتوفر عادةً بخيارات محرك تشمل سعة 4.0 لتر AMG تيربو مزدوج V8 (585 حصان)، مع ناقل حركة من 9 سرعات AMG Speedshift أوتوماتيكي. تتراوح أسعار سيارات مرسيدس-بنز G63 AMG المستعملة في السعودية عادةً بين 355,000 و545,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 4.0 لتر AMG تيربو مزدوج V8 (585 حصان)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e من 9 سرعات AMG Speedshift أوتوماتيكي\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 18.0 لتر/100 كم (استهلاك مجمع)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 4.5 ثانية\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 220 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. توفر منظومة الدفع ثباتاً جيداً وقدرات مناسبة في ظروف القيادة المختلفة.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون تكاليف الصيانة والإصلاح والتشغيل مرتفعة، خصوصاً بعد انتهاء الضمان.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ مرسيدس-بنز G63 AMG على نحو 24% من قيمتها الأصلية بعد 5 سنوات، كما تقل عن متوسط العلامة البالغ 43%.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eسيارات بديلة قد يهتم بها المشترون\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى رينج روفر، لكزس LX، وتويوتا لاند كروزر عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"745:T92e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجينيسيس G70 هي سيدان مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (252 حصان) أو سعة 3.3 لتر تيربو مزدوج V6 (370 حصان، Sport)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات جينيسيس G70 المستعملة في السعودية عادةً بين 140,000 و145,000 ريال، بحسب سنة الصنع والممشى.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eالمواصفات الرئيسية\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eخيارات المحرك:\u003c/strong\u003e سعة 2.0 لتر تيربو رباعي الأسطوانات (252 حصان) أو سعة 3.3 لتر تيربو مزدوج V6 (370 حصان، Sport)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eناقل الحركة:\u003c/strong\u003e أوتوماتيكي من 8 سرعات\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eاستهلاك الوقود:\u003c/strong\u003e حوالي 9.0 لتر/100 كم (استهلاك مجمع، 2.0T)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالتسارع من 0 إلى 100 كم/س:\u003c/strong\u003e حوالي 6.0 ثانية (2.0T) إلى حوالي 4.7 ثانية (3.3TT)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالسرعة القصوى:\u003c/strong\u003e 230-270 كم/س\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالمزايا والعيوب\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالمزايا:\u003c/strong\u003e يقدم المحرك أداءً قوياً واستجابة جيدة على الطرق داخل المدينة والطرق السريعة. تقدم مقصورة مريحة وراقية بمواد وتجهيزات مناسبة لفئتها.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالعيوب:\u003c/strong\u003e قد تكون قيمة إعادة البيع أضعف من بعض المنافسين الأكثر رسوخاً في السوق. شبكة مراكز الخدمة وقطع الغيار محدودة مقارنةً بالعلامات الأكثر انتشاراً.\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eالقيمة السوقية\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eتحافظ جينيسيس G70 على حوالي 41% من قيمتها الأصلية بعد مرور 5 سنوات — أقل من BMW الفئة 3 (45%).\u003c/p\u003e\n\u003cp\u003eينظر المشترون أيضاً إلى بي إم دبليو الفئة 3، مرسيدس-بنز الفئة C، وأودي A4 عند مقارنة الخيارات المتوفرة.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"746:T92e,"])</script><script>self.__next_f.push([1,"\u003cp\u003eجينيسيس G70 هي سيدان مدمجة عالية الأداء متوفرة في سوق السيارات المستعملة في السعودية. وتتوفر عادةً بخيارات محرك تشمل سعة 2.0 لتر تيربو رباعي الأسطوانات (252 حصان) أو سعة 3.3 لتر تيربو مزدوج V6 (370 حصان، Sport)، مع ناقل حركة أوتوماتيكي من 8 سرعات. تتراوح أسعار سيارات جينيسيس G70 المستعملة في السعودية عادةً بين 140,000 و145,000 ريال، بحسب